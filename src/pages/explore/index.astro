---
import Layout from '../../components/Layout.astro';
import {activities} from '../../lib/explorer-matching.js';
import {explorerRecords} from '../../lib/explorer-records.js';
import '../../styles/explore.css';

const questions = [
  {id:'known', title:'What do people ask you to help with?', hint:'Think about home, school, or time with friends.'},
  {id:'curious', title:'What would you like to try?', hint:'Include things you’ve never had the chance to do.'}
];
---
<Layout title="Explore what I could do" active="Explore" desc="Start with what you do or want to try. Explore jobs, meet Black workers in the historical record, and try a ten-minute activity.">
  <div class="frame explorer">
    <header class="explore-head">
      <div><p class="explore-kicker">Career explorer</p>
        <h1>Explore what I could do</h1>
        <p>Start with something familiar. Choose a job to try on paper. Each activity comes with a story from Black history and the record behind it.</p>
      </div>
      <p class="explore-aside">Already working?<br/><a href="/career-map/">Explore a career move <span aria-hidden="true">→</span></a></p>
    </header>

    <noscript><p class="explore-noscript">Open any of the jobs below to read its Door Note and try the activity.</p></noscript>
    <form class="explore-form" id="explore-form" hidden>
      {questions.map((q,index) => <section class="pick-step" data-step={index} hidden={index>0}>
        <div class="pick-copy">
          <p class="step-number">Question {index+1} of 2</p>
          <h2 id={'pick-'+q.id} tabindex="-1">{q.title}</h2>
          <p>{q.hint} Pick any that fit, or skip this question.</p>
        </div>
        <div class="pick-controls">
          <fieldset aria-labelledby={'pick-'+q.id}>
            <div class="pick-options">{activities.map(activity => <label>
              <input type="checkbox" name={q.id} value={activity.id}/>
              <span><strong>{activity.label}</strong><small>{activity.detail}</small></span>
            </label>)}</div>
          </fieldset>
          <div class="pick-actions">
            <button class="explore-primary" type="button" data-next>{index ? 'Show my paths' : 'Next question'} <span aria-hidden="true">→</span></button>
            <button class="explore-text" type="button" data-skip>Skip this question</button>
            {index > 0 && <button class="explore-text" type="button" data-back>Back</button>}
          </div>
        </div>
      </section>)}
      <div class="explore-form-foot"><p class="explore-privacy">Your choices stay in this tab.</p><a href="#all-jobs">Browse all {explorerRecords.length} jobs</a></div>
    </form>

    <section id="explore-results" aria-labelledby="result-heading">
      <div class="results-head" id="all-jobs">
        <div><p class="explore-kicker">Paths to explore</p>
          <h2 id="result-heading" tabindex="-1">Jobs you can try</h2>
          <p id="result-subtitle">Open a job to see the work and a Door Note.</p></div>
        <button type="button" id="change-answers" class="explore-text" hidden>Change my activities</button>
      </div>
      <div class="explore-paths">{explorerRecords.map((record,index) => <a class="explore-path" href={'#try-'+record.id} aria-label={'Open activity: '+record.title} aria-describedby={'summary-'+record.id} data-path={record.id} data-tags={record.tags.join(' ')}>
        <span class="result-row"><span class="slot-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
          <span class="path-identity"><strong>{record.title}</strong><span id={'summary-'+record.id}><span class="task-preview">{record.task}</span><span class="suggestion-why" data-why></span></span></span>
          <span class="open-sign" aria-hidden="true">→</span></span>
        <span class="result-action">Open activity <span aria-hidden="true">↗</span></span>
      </a>)}</div>
      <a class="results-all" id="more-jobs" href="#all-jobs" hidden>See all {explorerRecords.length} jobs</a>
    </section>
    {explorerRecords.map(record => <article id={'try-'+record.id} class="activity-sheet" aria-labelledby={'sheet-'+record.id}>
      <a href="#all-jobs" class="sheet-back" data-return>← Back to jobs</a>
      <header class="sheet-head">
        <p class="explore-kicker">Door Notes · Activity card</p>
        <h1 id={'sheet-'+record.id} tabindex="-1">{record.title}</h1>
        <p>{record.task}</p>
        <a href={record.taskSource.url} target="_blank" rel="noopener noreferrer">{record.taskSource.title} <span aria-hidden="true">↗</span></a>
      </header>
      <div class="sheet-columns">
        <section class="activity-experiment">
          <p class="sheet-meta">10 minutes · Pencil &amp; paper</p>
          <h2>Try the work</h2><p>{record.experiment}</p>
          <h3>When you’re done</h3><p>{record.reflect}</p>
        </section>
        <section class="sheet-note">
          <p class="sheet-meta">A Door Note · {record.door.year}</p>
          <h2>{record.door.person}</h2><p>{record.door.story}</p>
          <a href={record.door.source.url} target="_blank" rel="noopener noreferrer">{record.door.source.title} <span aria-hidden="true">↗</span></a>
          {record.door.artifact && <a href={record.door.artifact.url} target="_blank" rel="noopener noreferrer">{record.door.artifact.title} <span aria-hidden="true">↗</span></a>}
          <p class="door-limit"><strong>What’s still open:</strong> {record.door.limit}</p>
        </section>
      </div>
      <div class="sheet-further"><h2>Go further</h2><p>{record.next}</p>
        {record.pathUrl && <a href={record.pathUrl}>{record.pathUrl==='/career-map/' ? 'Explore the IT career map' : 'Read the workplace record'} <span aria-hidden="true">→</span></a>}
      </div>
      <div class="sheet-tools" hidden>
        <button class="explore-primary" type="button" data-copy>Copy activity link</button>
        <button class="explore-text" type="button" data-print>Print this card</button>
        <span class="sheet-notice" role="status"></span>
        <label class="sheet-fallback" hidden>Copy this activity link<input type="text" readonly/></label>
      </div>
      <p class="print-address">doornotes.org/explore/#try-{record.id}</p>
    </article>)}
    <footer class="explore-foot"><a href="/paths/">Explore workplace histories <span aria-hidden="true">→</span></a></footer>
  </div>
</Layout>
<script>
import {exploreActivities} from '../../lib/explorer-matching.js';

const form = document.querySelector<HTMLFormElement>('#explore-form')!;
const steps = [...form.querySelectorAll<HTMLElement>('[data-step]')];
const results = document.querySelector<HTMLElement>('#explore-results')!;
const heading = results.querySelector<HTMLElement>('#result-heading')!;
const cards = [...results.querySelectorAll<HTMLAnchorElement>('[data-path]')];
const sheets = [...document.querySelectorAll<HTMLElement>('.activity-sheet')];
const change = results.querySelector<HTMLButtonElement>('#change-answers')!;
const more = results.querySelector<HTMLAnchorElement>('#more-jobs')!;
const mast = document.querySelector<HTMLElement>('.explore-head')!;
const records = cards.map(card => ({id:card.dataset.path!,tags:card.dataset.tags!.split(' ')}));
const selected = (name:string) => [...form.querySelectorAll<HTMLInputElement>('input[name="'+name+'"]:checked')].map(input => input.value);
let cameFrom='all-jobs';
function focusPanel(panel:HTMLElement,title:HTMLElement,move:boolean) {
  if(!move) return;
  title.focus({preventScroll:true});
  panel.scrollIntoView({block:'start',behavior:'instant'});
}
function go(route:string) {
  if(location.hash === '#'+route) render(true);
  else location.hash = route;
}
function render(move:boolean) {
  const route=location.hash.slice(1);
  const sheet=sheets.find(item=>item.id===route);
  const list=route==='all-jobs' || route==='suggestions';
  steps.forEach((step,index)=>{step.hidden=index !== Number(route==='interests');});
  form.hidden = Boolean(sheet) || list;
  results.hidden = !list;
  mast.hidden = Boolean(sheet);
  for(const item of sheets) item.hidden=item!==sheet;
  if(sheet) {
    const back=sheet.querySelector<HTMLAnchorElement>('[data-return]')!;
    back.href='#'+cameFrom;
    back.textContent=cameFrom==='suggestions'?'← Back to my suggestions':'← Browse all jobs';
    sheet.querySelector<HTMLElement>('.sheet-tools')!.hidden=false;
    focusPanel(sheet,sheet.querySelector('h1')!,move);
    return;
  }
  if(list) {
    cameFrom=route;
    const all=route==='all-jobs';
    const picks = all ? records.map(r=>({id:r.id,why:''})) : exploreActivities(records,selected('known'),selected('curious'));
    for(const card of cards) card.hidden=true;
    const parent=results.querySelector('.explore-paths')!;
    picks.forEach((pick,index)=>{
      const card=cards.find(c=>c.dataset.path===pick.id)!;
      card.querySelector('[data-why]')!.textContent=pick.why;
      card.querySelector('.slot-number')!.textContent=String(index+1).padStart(2,'0');
      card.hidden=false;
      parent.append(card);
    });
    heading.textContent=all?'All jobs to try':picks.length===2?'Two paths to try':'Three paths to try';
    results.querySelector('#result-subtitle')!.textContent=all?'Pick a job to open its ten-minute activity and Door Note.':'Pick a job to try. Its activity card includes the work, a Door Note, and the sources.';
    more.hidden=all;
    change.textContent=all?'Choose activities':'Change my activities';
    change.hidden=false;
    focusPanel(results,heading,move);
  } else {
    const index=Number(route==='interests');
    focusPanel(form,steps[index].querySelector('h2')!,move);
  }
}
steps.forEach((step,index)=>{
  function advance() {go(index===0?'interests':'suggestions');}
  step.querySelector('[data-next]')!.addEventListener('click',advance);
  step.querySelector('[data-skip]')!.addEventListener('click',()=>{
    for(const input of step.querySelectorAll<HTMLInputElement>('input')) input.checked=false;
    advance();
  });
  step.querySelector('[data-back]')?.addEventListener('click',()=>go('activities'));
});
change.addEventListener('click',()=>go('activities'));
form.addEventListener('submit',event=>event.preventDefault());
for (const sheet of sheets) {
  sheet.querySelector('[data-print]')!.addEventListener('click',()=>window.print());
  sheet.querySelector('[data-copy]')!.addEventListener('click',async()=>{
    // The share address only carries the published job identifier.
    const url=new URL('/explore/#'+sheet.id,location.origin).href;
    const status=sheet.querySelector<HTMLElement>('.sheet-notice')!;
    try {
      await navigator.clipboard.writeText(url);
      status.textContent='Activity link copied.';
    } catch {
      const fallback=sheet.querySelector<HTMLElement>('.sheet-fallback')!;
      fallback.hidden=false;
      const input=fallback.querySelector('input')!;
      input.value=url; input.focus(); input.select();
      status.textContent='Select and copy the link below.';
    }
  });
}
// The global skip link should advance focus without leaving the current activity.
document.querySelector<HTMLAnchorElement>('a.skip')?.addEventListener('click', event=>{
  const section = sheets.find(item=>!item.hidden) || (!results.hidden ? results : form);
  const title = section.querySelector<HTMLElement>('[tabindex="-1"]:not([hidden])');
  if(title) {
    event.preventDefault();
    focusPanel(section, section===form ? steps.find(step=>!step.hidden)!.querySelector('h2')! : title, true);
  }
});
window.addEventListener('hashchange',()=>render(true));
render(Boolean(location.hash && location.hash!=='#content'));
</script>
