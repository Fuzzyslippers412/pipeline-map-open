---
import Layout from '../components/Layout.astro';
import TraceStart from '../components/TraceStart.astro';
import HistoryStories from '../components/HistoryStories.astro';
import {historyFor} from '../lib/field-history.js';
import {professions,idFor} from '../lib/model';
const filters=[...new Set(professions.map(p=>p.sector))];
const searchIndex=professions.map(({slug,name,aliases,sector})=>({slug,name,aliases,sector}));
---
<Layout title="Who opened the door to your career?" active="Index"><div class="frame">
<TraceStart/>
<HistoryStories/>
<section class="directory" id="directory"><div class="section-head"><div><div class="eyebrow">DIRECTORY <b>/</b> 01</div><h2>Profession index</h2></div><span class="indexcount" aria-live="polite" id="result-count">{professions.length} professions</span></div>
<form class="index-search" id="index-search" autocomplete="off">
  <div class="searchwrap">
    <label for="occupation" class="sr">Search the profession index</label>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
    <input id="occupation" type="search" maxlength="120" placeholder="Search by job title or profession" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="suggestions"/>
    <button type="submit" class="index-go" aria-label="Trace this job title" hidden>Trace <span aria-hidden="true">→</span></button>
    <kbd aria-hidden="true">/</kbd>
    <div id="suggestions" role="listbox" hidden></div>
  </div>
  <span id="index-announcements"></span>
</form>
<div id="directory-match" class="directory-match" hidden>
  <div><span class="directory-match-type"></span><strong class="directory-match-title"></strong><p class="directory-match-description"></p></div>
  <button type="button" class="index-action"></button>
</div>
<div class="filters" aria-label="Filter professions"><button class="pill selected" data-sector="" aria-pressed="true">All fields</button>{filters.map(s=><button class="pill" data-sector={s} aria-pressed="false">{s}</button>)}</div>
<div class="tiles" id="tiles">{professions.map(p=><a class="tile" data-id={p.slug} href={'/p/'+p.slug+'/'}><span class="tile-id">{idFor(p.slug)}</span><span class="tile-body"><strong>{p.name}</strong><small>{p.sector}</small><span class="tile-evidence">{historyFor(p).events[0]?.title}</span><span class="tile-coverage">{historyFor(p).expanded?'EXPANDED HISTORY':'STARTING RECORD'} · {historyFor(p).events.length} EPISODES</span></span><span class="tile-arrow" aria-hidden="true">↗</span></a>)}</div><div id="empty" hidden><p>No published profession cards fit these filters.</p><button id="reset" class="pill">Clear search and filters</button></div></section></div></Layout>
<script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex).replace(/</g,'\\u003c')}></script>
<script>
  import {bindProfessionIndex} from '../lib/profession-index.js';
  bindProfessionIndex();
</script>
<style>
.index-go, .index-action { display:inline-flex; align-items:center; justify-content:center; gap:6px; min-height:44px; color:var(--action,var(--teal)); font-weight:650; }
.index-go { flex:none; padding:0 4px; }
.directory-match { display:flex; justify-content:space-between; align-items:center; gap:10px 22px; margin-top:14px; padding:12px 16px; border-inline-start:3px solid var(--rust,var(--teal)); background:var(--panel); overflow-wrap:anywhere; }
.directory-match-type { display:block; font:600 .75rem/1.4 var(--sans); color:var(--muted); }
.directory-match-title { display:block; font:500 1.55rem/1.16 var(--serif); margin:3px 0; }
.directory-match-description { color:var(--muted); max-width:65ch; }
.index-action { text-align:left; text-decoration:underline; text-underline-offset:.2em; flex-shrink:0; }
@media(max-width:680px){ .directory-match { align-items:flex-start; flex-direction:column; gap:1px; padding:10px 12px; } .index-search kbd { display:none; } }
</style>
