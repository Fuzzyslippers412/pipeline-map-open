---
import Layout from '../components/Layout.astro';
import {sources,professions} from '../lib/model';
---
<Layout title="Source register" active="Sources"><div class="frame"><div class="page-head"><div class="eyebrow"><i></i> EVIDENCE <b>/</b> TABLE REGISTER</div><h1>Sources</h1><p>Follow an observation to its original table. Expand any entry for the population definition, usage terms and profession cards.</p></div><div class="subbody"><div class="exports"><a class="secondary" href="/data/observations.csv" download>Download observations ↓</a><a class="secondary" href="/data/sources.csv" download>Download source tables ↓</a></div><label class="sr" for="source-search">Find a source</label><input class="textfilter" type="search" placeholder="Filter by publisher, table or profession…" id="source-search"/><div class="tablewrap"><table class="source-table"><thead><tr><th><button class="sort" data-col="publisher">Publisher ↕</button></th><th><button class="sort" data-col="table">Table and definition ↕</button></th><th><button class="sort" data-col="date">Last checked ↕</button></th></tr></thead><tbody>{sources.map(s=><tr id={s.id} data-publisher={s.publisher} data-table={s.table_name} data-date={s.retrieved_on}><td>{s.publisher}</td><td><a href={s.url}>{s.table_name} ↗</a><details class="reading"><summary>Definition & coverage</summary><p>{s.definition}</p>{s.data_url&&<p><a href={s.data_url}>National person file (ZIP) ↗</a></p>}{s.dictionary_url&&<p><a href={s.dictionary_url}>Occupation codes and data dictionary ↗</a></p>}{s.limits&&<p>{s.limits}</p>}<small>{s.license}</small><p>{(s.professions||[]).map(slug=><a style="margin-right:8px" href={'/p/'+slug+'/'}>{professions.find(p=>p.slug===slug)?.name}</a>)}</p></details></td><td>{s.retrieved_on}</td></tr>)}</tbody></table></div><p id="no-sources" hidden>No source tables match that search.</p></div></div></Layout>
<script>
const tbody=document.querySelector('tbody')!, rows=[...tbody.querySelectorAll('tr')];let asc=1,last='';
document.querySelectorAll<HTMLButtonElement>('[data-col]').forEach(b=>b.addEventListener('click',()=>{const col=b.dataset.col!;asc=last===col?-asc:1;last=col;rows.sort((a,b)=>asc*(a.dataset[col]||'').localeCompare(b.dataset[col]||''));rows.forEach(r=>tbody.append(r));document.querySelectorAll('th').forEach(th=>th.removeAttribute('aria-sort'));b.parentElement?.setAttribute('aria-sort',asc===1?'ascending':'descending')}));
const search=document.querySelector<HTMLInputElement>('#source-search')!;search.addEventListener('input',()=>{const q=search.value.toLowerCase();rows.forEach(r=>r.hidden=!r.textContent?.toLowerCase().includes(q));(document.querySelector('#no-sources') as HTMLElement).hidden=rows.some(r=>!r.hidden)});
function reveal(){const target=document.getElementById(location.hash.slice(1));if(target){search.value='';rows.forEach(r=>r.hidden=false);const details=target.querySelector('details');if(details)details.open=true;target.scrollIntoView()}}window.addEventListener('hashchange',reveal);if(location.hash)reveal();
</script>
