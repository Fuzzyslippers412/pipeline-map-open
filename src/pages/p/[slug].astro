---
import Layout from '../../components/Layout.astro';
import CredentialRecord from '../../components/CredentialRecord.astro';
import Trend from '../../components/Trend.astro';
import PersonalTrace from '../../components/PersonalTrace.astro';
import FieldHistory from '../../components/FieldHistory.astro';
import {professions,idFor,labels,dataFor,roleFor} from '../../lib/model';
export function getStaticPaths(){return professions.map(p=>({params:{slug:p.slug},props:{p}}))}
const {p}=Astro.props;
const panels=[{name:'Origin',tag:'Institutions in this record',d:p.origin,codes:p.origin.builder},{name:'Gate',tag:'Separate decisions shape access',d:p.gate,codes:p.gate.gatekeeper}];
const url=new URL('/p/'+p.slug+'/',Astro.site).href;
---
<Layout title={p.name} desc={'Origin, entry and representation in the U.S. for '+p.name+'.'} og={'/p/'+p.slug+'/og.png'}><div class="frame cardframe"><div class="breadcrumb"><a href="/">Profession index</a><span>/</span>{p.sector}</div><div class="record-head"><div><div class="eyebrow"><i></i> PROFESSION <b>/</b> {idFor(p.slug)}</div><h1>{p.name}</h1></div><div class="actions"><button id="share" class="primary">Share card ↗</button><a href={'/compare/?p='+p.slug} class="secondary">Compare +</a></div></div>
<a class="secondary" href={'/career-map/'+p.slug+'/'}>Explore this career map →</a>
<PersonalTrace p={p}/>
<FieldHistory p={p}/>
<CredentialRecord slug={p.slug}/>
<div class="recordbody"><aside class="aside"><div class="eyebrow">IN THIS RECORD</div>{['Institutions','Entry decisions','Representation','Next question'].map((t,i)=><a href={'#'+['origin','gate','trend','role'][i]}><small>0{i+1}</small>{t}<span>↓</span></a>)}{p.soc_code&&<div class="soc">SOC classification<br/><strong>{p.soc_code}</strong></div>}</aside><div class="panels">{panels.map((obj,i)=><section class="panel" id={obj.name.toLowerCase()}><div class="num">0{i+1}</div><div class="panelmain"><div class="paneltop"><div class="eyebrow">{obj.name.toUpperCase()} <b>/</b> {obj.tag}</div><span class="edit-tag">Context & scope</span></div><h2>{obj.d.headline}</h2><p class="era">{obj.d.era}</p><details class="reading"><summary>Context, scope & sources</summary><p>{obj.d.rationale}</p><ul>{obj.d.citations.map(c=><li><a href={c.url}>{c.title} ↗</a></li>)}</ul></details></div></section>)}
<Trend p={p} rows={dataFor(p.slug)}/><section id="role" class="panel rolepanel"><div class="num">04</div><div class="panelmain"><div class="eyebrow">RESEARCH QUESTION</div><h2>{p.researchQuestion}</h2><p class="definition">{roleFor(p)}</p><a href="#research-question">See what is still open ↗</a></div></section>
<div class="record-foot"><a href="/sources/">Source register ↗</a><a href={'https://github.com/Fuzzyslippers412/pipeline-map-corrections/issues/new?template=correction.yml&title='+encodeURIComponent('[Correction] '+p.name)+'&record='+encodeURIComponent(url)}>Report an error ↗</a></div></div></div>
<dialog id="share-panel"><button id="close-share" class="close" aria-label="Close share panel">×</button><div class="eyebrow">SHARE THIS RECORD</div><h2>{p.name}</h2><img src={'/p/'+p.slug+'/og.png'} alt={'Door Notes research card for '+p.name} width="1200" height="630"/><div class="actions"><button class="primary" id="copy-url" data-url={url}>Copy link</button><a class="secondary" href={'https://twitter.com/intent/tweet?url='+encodeURIComponent(url)} target="_blank" rel="noopener noreferrer">Share on X ↗</a></div><output id="copied" aria-live="polite"></output></dialog></div></Layout>
<script>
const dialog=document.querySelector<HTMLDialogElement>('#share-panel')!;document.querySelector('#share')?.addEventListener('click',()=>dialog.showModal());document.querySelector('#close-share')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});document.querySelector('#copy-url')?.addEventListener('click',async()=>{const val=document.querySelector<HTMLElement>('#copy-url')!.dataset.url!;try{await navigator.clipboard.writeText(val);document.querySelector('#copied')!.textContent='Link copied.'}catch{document.querySelector('#copied')!.textContent=val}});
</script>
