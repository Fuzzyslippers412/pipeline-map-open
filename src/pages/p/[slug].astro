---
import Layout from '../../components/Layout.astro';
import Trend from '../../components/Trend.astro';
import PersonalTrace from '../../components/PersonalTrace.astro';
import {professions,idFor,labels,dataFor,roleFor} from '../../lib/model';
export function getStaticPaths(){return professions.map(p=>({params:{slug:p.slug},props:{p}}))}
const {p}=Astro.props;
const panels=[{name:'Origin',tag:'Who built the pipeline?',d:p.origin,codes:p.origin.builder},{name:'Gate',tag:'Who controls entry today?',d:p.gate,codes:p.gate.gatekeeper}];
const url=new URL('/p/'+p.slug+'/',Astro.site).href;
---
<Layout title={p.name} desc={'Origin, entry and representation in the U.S. for '+p.name+'.'} og={'/p/'+p.slug+'/og.png'}><div class="frame cardframe"><div class="breadcrumb"><a href="/">Profession index</a><span>/</span>{p.sector}</div><div class="record-head"><div><div class="eyebrow"><i></i> PROFESSION <b>/</b> {idFor(p.slug)}</div><h1>{p.name}</h1></div><div class="actions"><button id="share" class="primary">Share card ↗</button><a href={'/compare/?p='+p.slug} class="secondary">Compare +</a></div></div>
<PersonalTrace p={p}/>
<div class="recordbody"><aside class="aside"><div class="eyebrow">IN THIS RECORD</div>{['Origin','Gate','Trend','Your role'].map((t,i)=><a href={'#'+['origin','gate','trend','role'][i]}><small>0{i+1}</small>{t}<span>↓</span></a>)}{p.soc_code&&<div class="soc">SOC classification<br/><strong>{p.soc_code}</strong></div>}</aside><div class="panels">{panels.map((obj,i)=><section class="panel" id={obj.name.toLowerCase()}><div class="num">0{i+1}</div><div class="panelmain"><div class="paneltop"><div class="eyebrow">{obj.name.toUpperCase()} <b>/</b> {obj.tag}</div><span class="edit-tag">{obj.d.status==='draft'?'Editorial · proposed':'Editorial'}</span></div><h2>{obj.codes.map(x=>labels[x]).join(' + ')}</h2><p class="era">{obj.d.era}</p><details class="reading"><summary>Rationale & citations</summary><p>{obj.d.rationale}</p>{obj.d.status==='draft'&&<p class="status">Proposed classification · editorial review pending</p>}<ul>{obj.d.citations.map(c=><li><a href={c.url}>{c.title} ↗</a></li>)}</ul></details></div></section>)}
<Trend p={p} rows={dataFor(p.slug)}/><section id="role" class="panel rolepanel"><div class="num">04</div><div class="panelmain"><div class="eyebrow">YOUR ROLE <b>/</b> EDITORIAL MATRIX</div><h2>{roleFor(p)}</h2>{(p.origin.status==='draft'||p.gate.status==='draft')&&<p class="definition">This sentence reflects a proposed institutional pairing.</p>}<a href="/method/#role-matrix">See how this line is assigned ↗</a></div></section>
<div class="record-foot"><a href="/sources/">Source register ↗</a><a href={'https://github.com/Fuzzyslippers412/pipeline-map-corrections/issues/new?template=correction.yml&title='+encodeURIComponent('[Correction] '+p.name)+'&record='+encodeURIComponent(url)}>Report an error ↗</a></div></div></div>
<dialog id="share-panel"><button id="close-share" class="close" aria-label="Close share panel">×</button><div class="eyebrow">SHARE THIS RECORD</div><h2>{p.name}</h2><img src={'/p/'+p.slug+'/og.png'} alt="Preview of shared profession card" width="1200" height="630"/><div class="actions"><button class="primary" id="copy-url" data-url={url}>Copy link</button><a class="secondary" href={'https://twitter.com/intent/tweet?url='+encodeURIComponent(url)} target="_blank" rel="noopener noreferrer">Share on X ↗</a></div><output id="copied" aria-live="polite"></output></dialog></div></Layout>
<script>
const dialog=document.querySelector<HTMLDialogElement>('#share-panel')!;document.querySelector('#share')?.addEventListener('click',()=>dialog.showModal());document.querySelector('#close-share')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});document.querySelector('#copy-url')?.addEventListener('click',async()=>{const val=document.querySelector<HTMLElement>('#copy-url')!.dataset.url!;try{await navigator.clipboard.writeText(val);document.querySelector('#copied')!.textContent='Link copied.'}catch{document.querySelector('#copied')!.textContent=val}});
</script>
