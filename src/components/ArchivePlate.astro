---
const catalogue = 'https://www.loc.gov/item/2017696521/';
const scan = 'https://cdn.loc.gov/service/pnp/fsa/8b06000/8b06000/8b06029v.jpg';
---
<figure class="archive-plate">
  <a class="archive-image" href={scan} target="_blank" rel="noopener noreferrer" aria-label="Open the Library of Congress photograph at full size">
    <img
      src="/archive/freedmens-hospital-training-1943-320.webp"
      srcset="/archive/freedmens-hospital-training-1943-320.webp 320w, /archive/freedmens-hospital-training-1943-720.webp 720w"
      sizes="(max-width: 560px) 145px, 210px"
      width="320" height="383" loading="lazy" decoding="async"
      alt="A uniformed woman holds an ice cap above a basin while another woman in a nurse’s cap looks on."
    />
  </a>
  <figcaption>
    <span class="plate-date">February 1943 · Washington, D.C.</span>
    <h4>A lesson at Freedmen’s Hospital</h4>
    <p>Instructor Thelma Harris shows Maxine Jackson, a volunteer nurse’s aide, how to fill an ice cap.</p>
    <p class="plate-credit">Roger Smith, U.S. Office of War Information. Library of Congress, Prints &amp; Photographs Division.</p>
    <a class="plate-link" href={catalogue} target="_blank" rel="noopener noreferrer">Read the archive caption <span aria-hidden="true">↗</span></a>
  </figcaption>
</figure>

<style>
.archive-plate {
  display: grid;
  grid-template-columns: minmax(108px, 210px) minmax(0, 1fr);
  gap: clamp(16px, 3vw, 28px);
  align-items: start;
  margin: 18px 0 12px;
  padding-block: 16px;
  border-block: 1px solid var(--edge);
}
.archive-image { display: block; width: 100%; line-height: 0; }
.archive-image img { display: block; width: 100%; height: auto; }
.plate-date { color: var(--rust, var(--muted)); font: 600 .79rem/1.4 var(--sans); }
.archive-plate h4 { margin: 5px 0; color: var(--text); font: 500 clamp(22px, 3vw, 30px)/1.12 var(--serif); }
.archive-plate p { margin: 7px 0; color: var(--text); font: 400 1rem/1.45 var(--sans); }
.archive-plate .plate-credit { color: var(--muted); font-size: .83rem; }
.plate-link { display: inline-block; padding-block: 7px; color: var(--action, var(--teal)); font: 650 .94rem/1.35 var(--sans); text-decoration: underline; text-underline-offset: 3px; }
@media (max-width: 560px) {
  .archive-plate { grid-template-columns: minmax(0, 1fr); gap: 10px; }
  .archive-image { width: min(145px, 100%); }
}
</style>
