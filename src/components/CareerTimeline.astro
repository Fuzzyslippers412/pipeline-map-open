---
import PathDecisions from './PathDecisions.astro';
import {howardNursingDecisions} from '../lib/howard-nursing-decisions.js';
import {teacherDecisions} from '../lib/teacher-decisions.js';
import {electricianDecisions} from '../lib/electrician-decisions.js';
import '../styles/career-timeline.css';
import '../styles/timeline-preview.css';
const {profession}=Astro.props;
---
<pipeline-career-timeline id="career-timeline" class="career-timeline" hidden>
  <section class="path-preview" id="path-preview" aria-labelledby="path-preview-heading">
    <header class="path-preview-header">
      <div class="eyebrow"><i></i> <span data-preview-kicker>CAREER PATH</span></div>
      <h2 id="path-preview-heading" class="path-preview-title" tabindex="-1">Your path at a glance</h2>
      <p class="path-preview-person" data-person></p><p class="path-preview-affiliation" data-workplace-info hidden></p>
    </header>
    <div class="path-preview-sections" data-preview-sections hidden>
      {[
        ['opening','Who opened the door'],
        ['workplace','Your workplace connection'],
        ['gaps','What’s still unknown']
      ].map(([part,label])=><section class="path-preview-cell" data-part={part}>
        <h3 class="path-preview-label">{label}</h3>
        {part!=='gaps' && <span class="record-year" data-record-year hidden></span>}
        <p class="path-preview-headline" data-headline></p>
        {part!=='gaps' && <p class="record-place" data-record-place hidden></p>}
        <p class="path-preview-copy" data-copy hidden></p>
        {part==='gaps'?<>
          <ul class="path-preview-gap-list" data-gap-items></ul>
          <details class="record-corrections" data-gap-options hidden>
            <summary>Suggest a source</summary>
            <div data-correction-links></div>
          </details>
        </>:<div class="path-preview-source" data-preview-sources></div>}
        {part==='workplace' && <details class="source-note" data-source-note hidden>
          <summary>What the source shows</summary>
          <p data-source-explanation></p>
        </details>}
        {part==='workplace' && <a class="record-search" href="#workplace-lookup" data-workplace-search hidden>Look for a workplace source <span aria-hidden="true">↓</span></a>}
      </section>)}
    </div>
    <p class="path-preview-status" data-status role="status"></p>
    <button class="secondary timeline-retry" data-retry type="button" hidden>Retry profession history</button>
  </section>
  {(!profession || profession==='registered-nurse') && <PathDecisions anchor={!!profession} profession="registered-nurse" workplace="Howard University Hospital" subtitle="Anna B. Coles, Howard’s trustees and Congress" label="Decisions and leadership in Howard nursing" records={howardNursingDecisions}/>}
  {(!profession || profession==='k12-teacher') && <PathDecisions anchor={!!profession} profession="k12-teacher" subtitle="Black teacher training, pay and your school" label="Decisions in Black public-school teaching" records={teacherDecisions}/>}
  {(!profession || profession==='electrician') && <PathDecisions anchor={!!profession} profession="electrician" subtitle="Apprenticeships, contractors and jobsites" label="Decisions in the electrical trade" records={electricianDecisions}/>}
  <details class="path-full-timeline" data-full hidden>
    <summary>Explore the full timeline and sources</summary>
    <div class="path-full-timeline-body">
      <p class="timeline-note">Read from the earliest documented event to today. Each source explains one step. A gap marks a connection the evidence doesn’t establish.</p>
      <nav class="timeline-jumps" aria-label="Jump through your timeline"><a data-jump="timeline-history">Field history ↓</a><a data-jump="timeline-workplace">Workplace ↓</a><a data-jump="timeline-today">Your job ↓</a></nav>
      <ol class="timeline-steps" data-steps aria-label="Chronological steps"></ol>
    </div>
  </details>
  <div class="path-preview-actions"><a data-search-jump href="#workplace-lookup">Look for more workplace sources ↓</a></div>
</pipeline-career-timeline>

<script>
import {buildCareerTimeline} from '../lib/career-timeline.js';
import {buildTimelinePreview,paperRecordPreview} from '../lib/timeline-preview.js';
import {gapSourceLink} from '../lib/gap-source-link.js';
import {findWorkplaceLinks} from '../lib/trace-context.js';
import {teacherSchoolConnection} from '../lib/teacher-school-connection.js';
import {electricianConnection} from '../lib/electrician-connection.js';
import {currentDecisionRecord} from '../lib/decision-today.js';

type Context={employer:string,title:string,profession?:string,related?:boolean,workplaceInfo?:{workplace:string,parent?:string,location?:string,relation?:string}|null};
const cache=new Map<string,Promise<any>>();
function loadField(slug:string) {
  if(!/^[a-z0-9-]+$/.test(slug))return Promise.reject(new Error('Invalid profession'));
  let promise=cache.get(slug);
  if(!promise){
    promise=fetch('/data/pathways/'+slug+'.json'+(import.meta.env.DEV?'/':''),{credentials:'omit'}).then(async response=>{
      if(!response.ok)throw new Error('Profession history unavailable');
      const field=await response.json();
      if(field.slug!==slug||!Array.isArray(field.historical))throw new Error('Invalid profession history');
      return field;
    }).catch(e=>{cache.delete(slug);throw e});
    cache.set(slug,promise);
  }
  return promise;
}
function part(tag:string,className:string,text:string){
  const item=document.createElement(tag);item.className=className;item.textContent=text;return item;
}
class CareerTimeline extends HTMLElement{
  private context:Context|null=null;
  private field:any=null;
  private report:any=null;
  private loading=false;
  private failed=false;
  private scope:Element|null=null;
  connectedCallback(){
    this.scope=this.closest('[data-timeline-scope]');
    this.scope?.addEventListener('pipeline:research-results',this.onReport);
    this.querySelector('[data-retry]')?.addEventListener('click',this.retry);
    window.addEventListener('hashchange',this.followFragment);
  }
  disconnectedCallback(){
    this.scope?.removeEventListener('pipeline:research-results',this.onReport);
    this.querySelector('[data-retry]')?.removeEventListener('click',this.retry);
    window.removeEventListener('hashchange',this.followFragment);
  }
  private followFragment=()=>{
    if(!this.context || this.hidden) return;
    if(location.hash==='#path-preview'){this.focusPreview();return}
    if(location.hash!=='#decisions') return;
    const panel=this.querySelector<HTMLDetailsElement>('#decisions:not([hidden])');
    if(!panel)return;
    panel.open=true;
    requestAnimationFrame(()=>{
      if(!panel.hidden && panel.open && location.hash==='#decisions'){
        panel.querySelector('summary')?.focus({preventScroll:true});
        panel.scrollIntoView({block:'start',behavior:'instant'});
      }
    });
  };
  reset(){
    this.context=null;this.field=null;this.report=null;this.loading=false;this.failed=false;this.hidden=true;
    this.removeAttribute('data-record-edition');
    this.removeAttribute('data-school-edition');
    this.querySelector<HTMLDetailsElement>('[data-gap-options]')!.open=false;
    this.querySelector<HTMLDetailsElement>('[data-source-note]')!.open=false;
    const excerpt=this.querySelector<HTMLDetailsElement>('[data-school-excerpt]');
    if(excerpt)excerpt.open=false;
    this.querySelector('[data-person]')!.textContent='';
    this.querySelector('[data-status]')!.textContent='';
    this.querySelector('[data-workplace-info]')!.textContent='';
    this.querySelector('[data-steps]')!.replaceChildren();
    this.querySelector<HTMLElement>('[data-preview-sections]')!.hidden=true;
    const full=this.querySelector<HTMLDetailsElement>('[data-full]')!;
    full.open=false;full.hidden=true;
    for(const panel of this.querySelectorAll<HTMLDetailsElement>('[data-decisions-for]')){
      panel.open=false;panel.hidden=true;panel.removeAttribute('id');
    }
  }
  setContext(next:Context){
    if(!next?.title){this.reset();return}
    if(this.context && ['title','employer','profession','related'].every(k=>this.context![k as keyof Context]===next[k as keyof Context])&&JSON.stringify(this.context.workplaceInfo)===JSON.stringify(next.workplaceInfo))return;
    this.reset();this.context={...next};this.hidden=false;
    const paperEdition = ['k12-teacher','registered-nurse','electrician'].includes(next.profession || '') &&
      !next.related && !!this.closest('body.paper-edition');
    this.toggleAttribute('data-record-edition',paperEdition);
    this.toggleAttribute('data-school-edition',paperEdition && next.profession==='k12-teacher');
    this.querySelector('[data-preview-kicker]')!.textContent=paperEdition?'YOUR PATH AT A GLANCE':'CAREER PATH';
    this.querySelector('#path-preview-heading')!.textContent=paperEdition?next.title:'Your path at a glance';
    this.querySelector<HTMLElement>('[data-search-jump]')!.hidden=!next.employer;
    this.querySelector('[data-person]')!.textContent=paperEdition?(next.employer || (next.profession==='k12-teacher'?'No school entered':'No workplace entered')):next.title+(next.employer?' at '+next.employer:'');
    const hint=this.querySelector<HTMLElement>('[data-workplace-info]')!;
    const info=next.workplaceInfo?.workplace===next.employer?next.workplaceInfo:null;
    hint.textContent=info?[info.parent?(info.relation||'Parent organization')+': '+info.parent:'',info.location].filter(Boolean).join(' · '):'';
    hint.hidden=!hint.textContent;
    this.retry();
  }
  focusPreview(){
    if(!this.context||this.hidden)return;
    const target=this.querySelector<HTMLElement>('#path-preview-heading')!;
    target.focus({preventScroll:true});
    const preview=this.querySelector<HTMLElement>('#path-preview')!;
    preview.scrollIntoView({block:'start',behavior:'instant'});
  }
  private retry=async()=>{
    const context=this.context;if(!context)return;
    if(!context.profession){this.render();return}
    this.failed=false;this.loading=true;this.render();
    try{
      const field=await loadField(context.profession);
      if(this.context===context)this.field=field;
    }catch{if(this.context===context)this.failed=true}
    finally{if(this.context===context){this.loading=false;this.render()}}
  };
  private onReport=(event:Event)=>{
    const {context,report}=(event as CustomEvent).detail;
    if(!this.context||context.employer!==this.context.employer||context.title!==this.context.title||
      (context.profession||'')!==(this.context.related?'':this.context.profession||''))return;
    this.report=report;this.render();
  };
  private render(){
    if(!this.context)return;
    const list=this.querySelector<HTMLOListElement>('[data-steps]')!;
    const status=this.querySelector<HTMLElement>('[data-status]')!;
    this.querySelector<HTMLButtonElement>('[data-retry]')!.hidden=!this.failed;
    list.setAttribute('aria-busy',String(this.loading));
    if(this.loading){list.replaceChildren();status.textContent='Loading the field history…';return}
    const paperEdition=this.hasAttribute('data-record-edition');
    const steps=buildCareerTimeline({context:this.context,field:this.field,report:this.report,loadFailed:this.failed,paper:paperEdition});
    const basePreview=buildTimelinePreview({steps,context:this.context,loadFailed:this.failed,report:this.report});
    const preview=paperEdition?paperRecordPreview(basePreview,this.context,{report:this.report,loadFailed:this.failed}):basePreview;
    const sections=this.querySelector<HTMLElement>('[data-preview-sections]')!;
    const workplaceSearch=sections.querySelector<HTMLAnchorElement>('[data-workplace-search]')!;
    const showWorkplaceSearch=paperEdition && 'showSearch' in preview.workplace && preview.workplace.showSearch;
    workplaceSearch.hidden=!showWorkplaceSearch;
    const sourceNote=sections.querySelector<HTMLDetailsElement>('[data-source-note]')!;
    const explanation=paperEdition && 'sourceNote' in preview.workplace ? preview.workplace.sourceNote : '';
    sourceNote.hidden=!explanation;
    sourceNote.querySelector('[data-source-explanation]')!.textContent=explanation || '';
    if (!explanation) sourceNote.open=false;
    this.querySelector<HTMLElement>('[data-search-jump]')!.hidden=!this.context.employer || !!showWorkplaceSearch;
    sections.querySelector('[data-part="workplace"] .path-preview-label')!.textContent=
      'label' in preview.workplace?preview.workplace.label:'Your workplace connection';
    sections.querySelector('[data-part="gaps"] .path-preview-label')!.textContent=paperEdition?'What we still don’t know':'What’s still unknown';
    for(const key of ['opening','workplace','gaps'] as const){
      const cell=sections.querySelector<HTMLElement>('[data-part="'+key+'"]')!;
      const entry=preview[key];
      const date='date' in entry?entry.date:'';
      const headline=cell.querySelector<HTMLElement>('[data-headline]')!;
      headline.textContent=(!paperEdition && date ? date+' · ':'')+entry.title;
      headline.hidden=paperEdition && key==='gaps';
      const year=cell.querySelector<HTMLElement>('[data-record-year]');
      if(year){
        year.textContent=date;
        year.hidden=!paperEdition || !date;
        const undated = 'dated' in entry && entry.dated===false;
        cell.toggleAttribute('data-dated',!year.hidden && !undated);
        year.classList.toggle('record-date-unknown', undated);
        const place=cell.querySelector<HTMLElement>('[data-record-place]')!;
        place.textContent='place' in entry ? entry.place||'' : '';
        place.hidden=!paperEdition || !place.textContent;
      }
      const copy=cell.querySelector<HTMLElement>('[data-copy]')!;
      copy.textContent=entry.detail;copy.hidden=!entry.detail;
      if('sources' in entry){
        const refs=cell.querySelector<HTMLElement>('[data-preview-sources]')!;
        refs.replaceChildren(...entry.sources.map((source:{title:string,url:string})=>{
          const link=document.createElement('a');link.href=source.url;link.target='_blank';link.rel='noopener noreferrer';
          const [publisher,subject]=source.title.split(' · ');
          const samePublisher=entry.sources.some((other:{title:string})=>other!==source && other.title.split(' · ')[0]===publisher);
          link.textContent=((samePublisher&&subject)?subject:publisher)+' ↗';
          link.setAttribute('aria-label','Source: '+source.title);link.title=source.title;
          return link;
        }));
      }else{
        const options=cell.querySelector<HTMLDetailsElement>('[data-gap-options]')!;
        const links=options.querySelector('[data-correction-links]')!;
        links.replaceChildren();
        cell.querySelector('[data-gap-items]')!.replaceChildren(...entry.items.map((text:string,index:number)=>{
          const item=part('li','',text);
          const suggestion=gapSourceLink(entry.kinds[index],this.field?.name);
          if(suggestion){
            const link=document.createElement('a');
            link.className='gap-source-link';link.href=suggestion.href;link.target='_blank';link.rel='noopener noreferrer';
            link.textContent='Suggest a source ↗';link.setAttribute('aria-label',suggestion.label);
            link.title='Open a public GitHub draft with this gap prefilled';
            if(paperEdition){
              link.textContent=({opening:'Field history',workplace:this.context!.profession==='k12-teacher'?'School connection':'Workplace connection',route:'Hiring or training route'})[entry.kinds[index]]+' ↗';
              links.append(link);
            } else item.append(' ',link);
          }
          return item;
        }));
        options.hidden=!paperEdition || !links.childElementCount;
      }
    }
    sections.hidden=false;
    const panel=this.querySelector<HTMLDetailsElement>('[data-decisions-for="'+(this.context.profession||'')+'"]');
    if(panel && !this.context.related){
      const matches=findWorkplaceLinks(this.context.employer,this.context.profession,this.field?.reviewers,this.context.workplaceInfo);
      const firstRender=panel.hidden;
      panel.hidden=!!panel.dataset.workplace && !matches.some(row=>row.workplace===panel.dataset.workplace);
      if(!panel.hidden){
        panel.id='decisions';
        const today=currentDecisionRecord(this.context,matches);
        panel.querySelector<HTMLElement>('[data-today]')!.hidden=!today;
        if(today){
          panel.querySelector('[data-today-title]')!.textContent=today.title;
          panel.querySelector('[data-today-detail]')!.textContent=today.detail;
          const more=panel.querySelector<HTMLAnchorElement>('[data-today-link]')!;
          more.href=today.url;more.textContent=today.label+' ↗';
        }
        if(firstRender && location.hash==='#decisions') this.followFragment();
      }
      if(panel.dataset.decisionsFor==='k12-teacher' || panel.dataset.decisionsFor==='electrician'){
        const info=panel.dataset.decisionsFor==='electrician' ? electricianConnection(this.context,matches,this.failed) :
          teacherSchoolConnection(this.context,this.field?.reviewers,matches,this.failed);
        panel.querySelector('[data-local-label]')!.textContent=info.label;
        panel.querySelector('[data-local-name]')!.textContent=info.name;
        panel.querySelector('[data-local-gap]')!.textContent=info.gap;
        const bridge=panel.querySelector<HTMLElement>('[data-site-bridge]');
        if(bridge){
          const source='bridge' in info && info.bridge;
          bridge.hidden=!source;
          if(source){
            bridge.querySelector('p')!.textContent=source.detail;
            const to=bridge.querySelector('a')!;to.href=source.url;to.textContent=source.label+' ↗';
          }
        }
        const change=panel.querySelector<HTMLElement>('[data-local-change]')!;
        change.textContent=info.record?.description||'';change.hidden=!info.record;
        const link=panel.querySelector<HTMLAnchorElement>('[data-local-source]')!;
        link.hidden=!info.record;
        if(info.record){
          link.href=info.record.url;link.textContent=info.record.sourceTitle.split(' · ').at(-1)+' ↗';
          link.setAttribute('aria-label','Source: '+info.record.sourceTitle);
        }else link.removeAttribute('href');
        const excerpt=panel.querySelector<HTMLDetailsElement>('[data-school-excerpt]');
        if(excerpt){
          const record=paperEdition && info.record?.scope==='school'?info.record:null;
          excerpt.hidden=!record?.excerpt || !record.excerptLocator;
          if(!excerpt.hidden){
            excerpt.querySelector('[data-excerpt-text]')!.textContent='“'+record.excerpt+'”';
            const citation=excerpt.querySelector<HTMLAnchorElement>('[data-excerpt-link]')!;
            citation.href=record.url;
            citation.textContent=record.sourceTitle.split(' · ')[0]+' · '+record.excerptLocator+' ↗';
          }
        }
      }
    }
    const full=this.querySelector<HTMLDetailsElement>('[data-full]')!;
    full.hidden=false;
    const rows=steps.map(step=>{
      const li=document.createElement('li');li.className='timeline-step';li.dataset.kind=step.type;
      li.append(part('span','timeline-date',step.date));
      const content=document.createElement('div');content.className='timeline-content';
      content.append(part('span','timeline-category',step.label),part('h3','',step.title),part('p','',step.detail));
      if(step.bridge)content.append(part('p','timeline-bridge',step.bridge));
      if(step.meta)content.append(part('small','timeline-meta',step.meta));
      if(step.sources.length){
        const refs=document.createElement('div');refs.className='timeline-sources';
        for(const source of step.sources){
          const a=document.createElement('a');a.href=source.url;a.target='_blank';a.rel='noopener noreferrer';
          a.textContent=source.title+' ↗';refs.append(a);
        }
        content.append(refs);
      }else if(step.type==='self'){content.append(part('small','timeline-meta','Source: the job details you entered in this tab.'))}
      li.append(content);return li;
    });
    const workplaceIndex=steps.findIndex(step=>step.type==='employer'||step.type==='award');
    const gapIndex=steps.findIndex((step,i)=>i>0&&step.type==='gap');
    const targets={
      'timeline-history':rows[Math.max(0,steps.findIndex(step=>step.type==='history'))],
      'timeline-workplace':rows[workplaceIndex>=0?workplaceIndex:gapIndex],
      'timeline-today':rows.at(-1)
    };
    for(const [id,row] of Object.entries(targets)){
      const jump=this.querySelector<HTMLAnchorElement>('[data-jump="'+id+'"]')!;
      jump.hidden=!row;
      if(row){const marker=document.createElement('span');marker.id=id;marker.className='timeline-anchor';row.append(marker);jump.href='#'+id}
    }
    list.replaceChildren(...rows);
    const documented=steps.filter(s=>['history','employer','award'].includes(s.type)).length;
    const summary=documented+' sourced '+(documented===1?'milestone':'milestones')+' in the full timeline.';
    status.textContent=this.report?'Preview updated from workplace search. '+summary:summary;
    if(['#timeline-history','#timeline-workplace','#timeline-today'].includes(location.hash)&&!this.report){
      full.open=true;requestAnimationFrame(()=>document.getElementById(location.hash.slice(1))?.scrollIntoView({block:'start',behavior:'instant'}));
    }
  }
}
if(!customElements.get('pipeline-career-timeline'))customElements.define('pipeline-career-timeline',CareerTimeline);
</script>
