---
import records from '../../data/credential-records.json';
const record = records.find(row => row.slug === Astro.props.slug);
---
{record && <section id="credential-record" class="credential-record" aria-labelledby="credential-person">
  <div class="stamp"><span>Field history</span><strong>{record.year}</strong></div>
  <div><p class="kind">{record.credential}</p><h2 id="credential-person">{record.name}</h2>
  <p>{record.record}</p><p>{record.work}</p>
  <div class="sources">{record.sources.map(s=><a href={s.url}>{s.label} <span aria-hidden="true">↗</span></a>)}</div></div>
</section>}
<style>
.credential-record {display:grid;grid-template-columns:minmax(85px,.22fr) minmax(0,1fr);gap:12px 24px;max-width:920px;margin:12px 0 24px;padding:20px 0;border-block:1px solid var(--edge);scroll-margin-top:20px}
.stamp span,.kind {font:600 .78rem/1.4 var(--sans);color:var(--rust)}
.stamp strong {display:block;font:500 clamp(32px,4vw,48px)/1.1 var(--serif);color:var(--rust)}
h2 {font:500 clamp(27px,4vw,39px)/1.05 var(--serif);margin:4px 0 10px}
h2 ~ p {max-width:62ch;margin:6px 0}
.sources {display:flex;flex-wrap:wrap;gap:0 16px}
a {display:inline-flex;align-items:center;min-height:44px;color:var(--action);text-decoration:underline;text-underline-offset:.18em}
@media(max-width:540px){.credential-record {grid-template-columns:1fr;gap:6px}.stamp {display:flex;align-items:baseline;gap:12px}.stamp strong {font-size:27px}}
</style>
