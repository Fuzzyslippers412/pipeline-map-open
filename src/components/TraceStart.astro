---
import {professions} from '../lib/model';
import workplaces from '../../data/workplace-directory.json';
import {pathExamples,examplePath} from '../lib/path-examples.js';
import {normalizeEmployerText} from '../lib/employer-key.js';
const featured=workplaces.records.filter(row=>row.source?.startsWith('verified-'));
const featuredParents=new Set(featured.filter(row=>row.parent).map(row=>normalizeEmployerText(row.parent)));
const quickWorkplaces=workplaces.records.filter(row=>row.source?.startsWith('verified-')||featuredParents.has(normalizeEmployerText(row.name)))
  .map(row=>({...row,sourceUrl:workplaces.sources[row.source]?.url,priority:row.source?.startsWith('verified-')?2:1}));
import SourceLookup from './SourceLookup.astro';
import ClassicTraceEntry from './ClassicTraceEntry.astro';
const originalEdition = Astro.url.pathname.startsWith('/study/original/');
import CareerTimeline from './CareerTimeline.astro';
import PmRoleHistory from './PmRoleHistory.astro';
import ProjectWork from './ProjectWork.astro';
import ComputingContext from './ComputingContext.astro';
import '../styles/trace-start.css';
import '../styles/trace-combobox.css';
---
{originalEdition ? <ClassicTraceEntry/> : <section class="trace-front" id="trace" aria-labelledby="trace-heading">
  <div class="trace-lead">
    <div class="eyebrow">BLACK CAREER PATHWAYS</div>
    <h1 id="trace-heading">Who opened the door to your <em>career?</em></h1>
    <p>Trace the people and decisions that opened your field to Black workers. Or start with something you enjoy and see where it leads.</p>
    <nav class="start-options" aria-label="Choose a starting point">
      <a class="start-trace" href="#job-trace-form">Trace my job <span aria-hidden="true">↓</span></a>
      <a class="start-explore" href="/explore/">Explore what I could do <span aria-hidden="true">→</span></a>
    </nav>
    <aside class="field-note" aria-label="From the teacher record">
      <div class="field-note-caption">FROM THE TEACHER RECORD</div>
      <div class="field-note-entry">
        <span class="field-note-year">1867</span>
        <div><strong>The Marion Nine open Lincoln Normal School.</strong>
          <span>Marion, Alabama</span>
          <a href="https://www.alasu.edu/about/history-tradition.php" target="_blank" rel="noopener noreferrer">Alabama State University <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </aside>
  </div>
  <div class="trace-box">
    <p id="exercise-prompt" class="exercise-prompt" hidden><strong>Reader exercise</strong> These fields contain a fictional school and a teacher’s title. Choose “Trace my path” to see what the records can tell you.</p>
    <form id="job-trace-form" autocomplete="off" aria-label="Trace my career">
      <div class="trace-field">
        <div class="trace-field-heading">
          <label for="workplace-entry">Where do you work? <small>Optional</small></label>
          <button id="reset-trace" type="button" hidden>Clear entries</button>
        </div>
        <div class="trace-combobox-wrap">
          <input id="workplace-entry" type="text" maxlength="160" placeholder="Start typing your workplace" autocomplete="off"/>
          <div id="workplace-suggestions" hidden></div>
        </div>
        <span id="workplace-announcements"></span>
        <p id="workplace-affiliation" class="entry-affiliation" hidden></p>
      </div>
      <div class="trace-field">
        <label for="title-entry">What’s your job title?</label>
        <div class="trace-combobox-wrap">
          <input id="title-entry" type="text" maxlength="120" required placeholder="e.g. Public school teacher" autocomplete="off"/>
          <div id="title-suggestions" hidden></div>
        </div>
        <span id="title-announcements"></span>
        <p id="title-affiliation" class="entry-affiliation" hidden></p>
      </div>
      <button class="primary trace-submit" type="submit" disabled>Trace my path <span aria-hidden="true">→</span></button>
    </form>
    <a id="try-teacher" class="featured-example" href="/p/k12-teacher/?example=1#path-preview">Try the Atlanta teacher example <span aria-hidden="true">→</span></a>
    <details class="other-examples">
      <summary>Nursing and electrical examples</summary>
      <div class="other-example-links">
        {pathExamples.filter(example => example.slug !== 'k12-teacher').map(example => (
          <a id={example.id} href={examplePath(example.slug)}>{example.label} <span aria-hidden="true">→</span></a>
        ))}
      </div>
    </details>
    <div class="trace-guides">
      <a class="library-link" href="/paths/">Explore the workplace library <span aria-hidden="true">→</span></a>
      <a class="library-link" href="/career-map/">Explore the Career map <span aria-hidden="true">→</span></a>
    </div>
    <p class="privacy-line">Job or workplace not listed? Keep what you typed and trace it. Typing stays in this tab.</p>
    <details id="more-workplaces" class="more-workplaces" data-contextual hidden>
      <summary>Look for this workplace in federal records</summary>
      <p>Search the U.S. Treasury’s award recipient directory. Only the button below sends the workplace name to USAspending.</p>
      <button id="search-federal-workplaces" type="button" class="secondary" disabled>Search federal recipients</button>
      <p id="federal-status" role="status"></p><div id="federal-results"></div>
    </details>
    <noscript><p>Browse the <a href="#directory">profession index</a> below to follow a field’s history.</p></noscript>
  </div>
</section>}
<section id="match-result" data-timeline-scope aria-labelledby="match-heading" hidden>
  <p id="match-kicker" class="eyebrow"></p>
  <h2 id="match-heading" tabindex="-1"></h2>
  <p id="match-site" hidden></p>
  <p id="match-message"></p>
  <div id="suggested-paths"></div>
  <button type="button" id="change-duty" class="edit-trace-entry" hidden>Change my answer</button>
  <ProjectWork inTrace/>
  <PmRoleHistory role="product-manager" inTrace/>
  <PmRoleHistory role="program-manager" inTrace/>
  <ComputingContext/>
  <CareerTimeline/>
  <SourceLookup/>
  <details id="manual-choice" hidden>
    <summary>Explore another field’s history</summary>
    <label for="manual-profession">Choose a published field</label>
    <select id="manual-profession"><option value="">Select a field…</option>{professions.map(p=><option value={p.slug}>{p.name}</option>)}</select>
    <button type="button" id="manual-open" class="secondary" disabled>Read this related history →</button>
  </details>
  <a href="#trace" class="edit-trace-entry">Edit workplace or title ↑</a>
</section>
<script type="application/json" id="quick-workplaces" set:html={JSON.stringify(quickWorkplaces).replace(/</g,'\\u003c')}></script>
<script>
import {showPmWorkplace} from '../lib/pm-role-panel.js';
import {focusPmPath} from '../lib/pm-path-panel.js';
import {setProjectSector} from '../lib/project-panel.js';
import {setupTraceEntryFields} from '../lib/trace-entry-fields.js';
import {bindLookup,revealTimelinePreview} from '../lib/bind-lookup.js';
import {resolveTitle,loadTitleDirectory} from '../lib/title-resolver.js';
import {careerGuideFor,showComputingContext} from '../lib/computing-context.js';
import {saveTrace,readTrace,clearTrace} from '../lib/trace-context.js';
const catalog=JSON.parse(document.querySelector('#search-index')!.textContent!);
const form=document.querySelector<HTMLFormElement>('#job-trace-form')!;
const employer=document.querySelector<HTMLInputElement>('#workplace-entry')!;
const job=document.querySelector<HTMLInputElement>('#title-entry')!;
const reset=document.querySelector<HTMLButtonElement>('#reset-trace')!;
const result=document.querySelector<HTMLElement>('#match-result')!;
const heading=document.querySelector<HTMLHeadingElement>('#match-heading')!;
const message=document.querySelector<HTMLElement>('#match-message')!;
const choices=document.querySelector<HTMLElement>('#suggested-paths')!;
const changeDuty=document.querySelector<HTMLButtonElement>('#change-duty')!;
const lookup=result.querySelector('pipeline-source-lookup');
const timeline=result.querySelector('pipeline-career-timeline');
const quickWorkplaces=JSON.parse(document.querySelector('#quick-workplaces')!.textContent!);
const entries=setupTraceEntryFields(form,catalog,quickWorkplaces);
type Resolution = {
  kind: 'exact'|'choices'|'related'|'recognized'|'unknown';
  title: string;
  slug?: string;
  occupation?: string;
  projectSector?: string;
  pmRole?: string;
  occupations?: {code:string}[];
  computing?: boolean;
  contextKey?: string;
  question?: string;
  choices?: {label:string;result:Resolution}[];
};
type Draft = {title:string;lookupTitle:string;choicePath:string[];occupationCode?:string};
const kicker = document.querySelector<HTMLElement>('#match-kicker')!;
const siteLabel = document.querySelector<HTMLElement>('#match-site')!;
const manual = document.querySelector<HTMLDetailsElement>('#manual-choice')!;
const select = document.querySelector<HTMLSelectElement>('#manual-profession')!;
const manualOpen = document.querySelector<HTMLButtonElement>('#manual-open')!;
const note = result.querySelector<HTMLElement>('[data-computing-context]');
let generation = 0;
let activeDraft: Draft | null = null;

function clearResults() {
  generation++;
  activeDraft = null;
  bindLookup(timeline,null);
  bindLookup(lookup,null);
  result.querySelectorAll('door-employer-records').forEach(el=>bindLookup(el,null));
  showComputingContext(note,null);
  result.querySelector<HTMLElement>('[data-project-work]')!.hidden=true;
  for(const panel of result.querySelectorAll<HTMLElement>('[data-pm-history]')) panel.hidden=true;
  result.hidden = true;
  manual.hidden = true;
  manual.open = false;
  select.value = '';
  manualOpen.disabled = true;
  choices.replaceChildren();
  changeDuty.hidden = true;
  result.querySelector('[data-match-gap]')?.remove();
  job.setCustomValidity('');
}

function currentDraft(): Draft {
  const selection = entries.titleSelection;
  const value = job.value.trim();
  return {title:selection?.typed || value, lookupTitle:selection?.lookup || value, choicePath:[]};
}

function contextFor(draft:Draft, profession='', related=false) {
  return {title:draft.title,lookupTitle:draft.lookupTitle,occupationCode:draft.occupationCode, employer:employer.value.trim(), profession, related, workplaceInfo:entries.workplaceInfo};
}

function remember(draft:Draft, slug='', match='unmapped') {
  return saveTrace({...draft, workplace:employer.value.trim(), workplaceInfo:entries.workplaceInfo, slug, match});
}

function showResult(draft:Draft, badge:string, description:string, focus:boolean) {
  result.hidden = false;
  kicker.textContent = badge;
  heading.textContent = draft.title;
  siteLabel.hidden = !employer.value.trim();
  siteLabel.textContent = siteLabel.hidden ? '' : 'At ' + employer.value.trim();
  message.textContent = description;
  if(focus) {
    heading.focus({preventScroll:true});
    result.scrollIntoView({block:'start',behavior:'instant'});
  }
}

function addChoice(label:string, action:()=>void) {
  const button = document.createElement('button');
  button.type = 'button';
  button.className = 'trace-choice';
  button.textContent = label;
  button.addEventListener('click', action);
  choices.append(button);
}

function openRecord(draft:Draft, slug:string, match='title') {
  const record = catalog.find((row:{slug:string}) => row.slug===slug);
  if(!record) return;
  const originalTeacher = location.pathname.startsWith('/study/original/') && slug==='k12-teacher';
  const url = (originalTeacher ? '/study/original/p/' : '/p/') + slug + '/';
  if(remember(draft,slug,match)) {
    location.assign(url+'#path-preview');
    return;
  }

  // Storage can be blocked. The same trace and evidence stay available in this tab.
  clearResults();
  activeDraft = draft;
  showResult(draft, match==='related' ? 'Related field' : 'Matched profession', 'Read the '+record.name+' history below.', true);
  const context = contextFor(draft,slug,match==='related');
  bindLookup(timeline,context);
  bindLookup(lookup,{...context,profession:context.related ? '' : slug});
  revealTimelinePreview(timeline);
  const link = document.createElement('a');
  link.href = url;
  link.className = 'trace-choice';
  link.textContent = 'Open the public '+record.name+' record →';
  choices.append(link);
}

function renderResolution(resolution:Resolution, draft:Draft, focus:boolean, directoryUnavailable=false) {
  clearResults();
  if(resolution.occupations?.length===1)draft={...draft,occupationCode:resolution.occupations[0].code};
  activeDraft = draft;
  changeDuty.hidden = !draft.choicePath.length;
  if(focus) remember(draft);
  const workplace = employer.value.trim();
  const context = contextFor(draft);
  switch(resolution.kind) {
    case 'exact': {
      const record = catalog.find((row:{slug:string}) => row.slug===resolution.slug);
      if(record && focus) { openRecord(draft,record.slug); return; }
      showResult(draft,'Matched profession','This title matches a published profession.',focus);
      if(record) addChoice('Open '+record.name+' →',()=>openRecord(draft,record.slug));
      return;
    }
    case 'choices': {
      showResult(draft,'Choose a path',resolution.question || 'Which kind of work do you do?',focus);
      for(const option of resolution.choices || []) {
        addChoice(option.label,()=>{
          renderResolution(option.result,{...draft,choicePath:[...draft.choicePath,option.label]},true);
        });
      }
      return;
    }
    case 'related':
    case 'recognized': {
      if(resolution.pmRole){
        showResult(draft,'Career path',resolution.occupation+' · Documented field history',focus);
        const panel=result.querySelector<HTMLElement>('[data-pm-history="'+resolution.pmRole+'"]')!;
        showPmWorkplace(panel,workplace);
        panel.querySelector<HTMLDetailsElement>(':scope > details')!.open=false;
        panel.hidden=false;
        if(focus)focusPmPath(panel);
        manual.hidden=false;return;
      }
      if(resolution.projectSector) {
        showResult(draft,'Career path','Project managers coordinate schedules, resources and delivery across fields.',focus);
        const panel=result.querySelector<HTMLElement>('[data-project-work]')!;
        panel.hidden=false;
        setProjectSector(panel,(!focus && readTrace()?.projectSector) || resolution.projectSector,workplace);
        if(focus)focusPmPath(panel);
        manual.hidden=false;return;
      }
      const occupation = resolution.occupation || resolution.title;
      const record = catalog.find((row:{slug:string}) => row.slug===resolution.slug);
      const fieldName = record?.slug==='software-engineer' ? 'software engineering' : record?.name.toLowerCase();
      const detail = record ? 'Explore '+fieldName+' as a related field.' : 'Door Notes hasn’t published a history specific to this role yet.';
      showResult(draft,'Occupation recognized',occupation + '. ' + detail,focus);
      if(record) addChoice('Read the '+fieldName+' history →',()=>openRecord(draft,record.slug,'related'));
      const guide = careerGuideFor(resolution);
      if(guide) {
        const link = document.createElement('a');
        link.className = 'trace-choice';
        const code=resolution.occupations?.[0]?.code;
        link.href = guide.href==='/career-map/' && code ? '/career-map/?occupation='+encodeURIComponent(code) : guide.href;
        link.textContent = guide.label+' →';
        choices.append(link);
      }
      if(!guide) {
        const link=document.createElement('a');
        const code=resolution.occupations?.[0]?.code;
        link.href=code?'/career-map/?occupation='+encodeURIComponent(code):'/career-map/';
        link.className='trace-choice';
        link.textContent='Explore this work in Career map →';
        choices.append(link);
      }
      if(resolution.computing) {
        showComputingContext(note,{...context,computing:true,contextKey:resolution.contextKey,canonicalTitle:resolution.title,occupation});
      } else if(workplace) {
        const gap = document.createElement('p');
        gap.className = 'match-gap';
        gap.textContent = record ? 'Open the field history to check reviewed workplace records and the remaining gaps.' : 'A connection to '+workplace+' still needs a source.';
        choices.after(gap);
        gap.dataset.matchGap = '';
      }
      break;
    }
    default:
      showResult(draft,'Your job title',directoryUnavailable
        ? 'The full title directory is unavailable. You can still use your wording, search workplace sources, or select a related field.'
        : 'Door Notes hasn’t matched this title to a reviewed history. You can explore a related field or look for a workplace source.',focus);
      const mapLink=document.createElement('a');
      mapLink.href='/career-map/';mapLink.className='trace-choice';mapLink.textContent='Browse the Career map →';choices.append(mapLink);
      bindLookup(timeline,context);
  }

  bindLookup(lookup,context);
  manual.hidden = false;
}

async function resolveDraft(draft:Draft, focus=true) {
  clearResults();
  const request = generation;
  let directoryUnavailable = false;
  let resolution = resolveTitle(draft.lookupTitle,catalog) as Resolution;
  if(resolution.kind==='unknown') {
    showResult(draft,'Checking the title directory','Looking up this occupation…',false);
    const directory = await loadTitleDirectory();
    if(request!==generation) return;
    directoryUnavailable = !directory;
    resolution = resolveTitle(draft.lookupTitle,catalog,directory) as Resolution;
  }
  const restoredPath:string[] = [];
  for(const label of draft.choicePath) {
    const option = resolution.choices?.find(row=>row.label===label);
    if(!option) break;
    restoredPath.push(label);
    resolution = option.result;
  }
  renderResolution(resolution,{...draft,choicePath:restoredPath},focus,directoryUnavailable);
}

function savedFields(restoring=false) {
  const saved = readTrace();
  if(restoring || !employer.value) employer.value = saved?.workplace || '';
  if(restoring || !job.value) job.value = saved?.title || '';
  entries.restore(saved?.workplaceInfo);
  entries.selectTitle(job.value,saved?.lookupTitle || '');
  reset.hidden = !employer.value && !job.value;
  const hadInlineResult = saved && (saved.match==='unmapped' || saved.match==='related' || saved.choicePath?.length);
  if(hadInlineResult && saved.title===job.value && saved.workplace===employer.value) {
    void resolveDraft({title:saved.title,lookupTitle:saved.lookupTitle || saved.title,choicePath:saved.choicePath || []},false);
  }
}

form.addEventListener('submit',event=>{
  event.preventDefault();
  if(!job.value.trim()) {
    job.setCustomValidity('Enter your job title.');
    job.reportValidity();
    return;
  }
  void resolveDraft(currentDraft());
});
select.addEventListener('change',()=>manualOpen.disabled=!select.value);
changeDuty.addEventListener('click',()=>{
  if(activeDraft?.choicePath.length) {
    void resolveDraft({...activeDraft,choicePath:activeDraft.choicePath.slice(0,-1)});
  }
});
manualOpen.addEventListener('click',()=>openRecord(activeDraft || currentDraft(),select.value,'related'));
form.addEventListener('input',()=>{
  clearResults();
  const saved = readTrace();
  if(saved && (saved.title!==job.value.trim() || saved.workplace!==employer.value.trim())) clearTrace();
  reset.hidden = !job.value && !employer.value;
});
document.addEventListener('doornotes:trace-title',event=>{
  const detail = (event as CustomEvent).detail;
  if(typeof detail?.title!=='string' || !detail.title.trim()) return;
  job.value = detail.title.trim().slice(0,120);
  job.dispatchEvent(new Event('input',{bubbles:true}));
  entries.selectTitle(job.value,typeof detail.lookupTitle==='string' ? detail.lookupTitle.trim().slice(0,120) : '');
  form.requestSubmit();
});
reset.addEventListener('click',()=>{
  document.querySelector<HTMLElement>('#exercise-prompt')?.setAttribute('hidden','');
  clearTrace(); form.reset(); entries.clear(); clearResults();
  reset.hidden=true; employer.focus();
});
for(const button of document.querySelectorAll<HTMLButtonElement>('.trace-example [data-example]')){
  button.disabled=false;
  button.addEventListener('click',()=>{
    const example=JSON.parse(button.dataset.example!);
    entries.example(example.workplace,example.site);job.value=example.title;reset.hidden=false;form.requestSubmit();
  });
}
const exercisePrompt = document.querySelector<HTMLElement>('#exercise-prompt');
const readerExercise = exercisePrompt && new URL(location.href).searchParams.get('exercise') === 'unlisted';
if (readerExercise) {
  exercisePrompt.hidden = false;
  entries.example('Door Notes Practice School (fictional)');
  job.value = 'Public school teacher';
  reset.hidden = false;
} else {
  savedFields();
}
form.querySelector<HTMLButtonElement>('.trace-submit')!.disabled=false;
window.addEventListener('pageshow',event=>{if(event.persisted){clearResults();savedFields(true)}});

</script>
<style>
  #change-duty { min-height:44px; margin-top:2px; padding-inline:0; }
</style>
