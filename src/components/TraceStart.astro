---
import {professions} from '../lib/model';
import workplaces from '../../data/workplace-directory.json';
import schools from '../../data/workplace-schools.json';
const teacherSchool=schools.records.find(row=>row.id==='nces-school-130012004174')!;
import {normalizeEmployerText} from '../lib/employer-key.js';
const featured=workplaces.records.filter(row=>row.source?.startsWith('verified-'));
const featuredParents=new Set(featured.filter(row=>row.parent).map(row=>normalizeEmployerText(row.parent)));
const quickWorkplaces=workplaces.records.filter(row=>row.source?.startsWith('verified-')||featuredParents.has(normalizeEmployerText(row.name)))
  .map(row=>({...row,priority:row.source?.startsWith('verified-')?2:1}));
import SourceLookup from './SourceLookup.astro';
import CareerTimeline from './CareerTimeline.astro';
import '../styles/trace-start.css';
import '../styles/trace-combobox.css';
---
<section class="trace-front" id="trace" aria-labelledby="trace-heading">
<div class="trace-lead"><div class="eyebrow"><i></i> BLACK CAREER PATHWAYS <b>/</b> UNITED STATES</div><h1 id="trace-heading">Who opened the door to <em>your career?</em></h1><p>A field guide for Black professionals. Enter your job and employer to see a timeline of the institutions that opened your field to Black Americans, with sources and gaps along the way.</p>
<div class="trace-mini" aria-hidden="true"><span>Field history</span><i></i><span>Workplace</span><i></i><span>Your job</span></div></div>
<div class="trace-box"><div class="trace-box-title"><span class="eyebrow">YOUR STARTING POINT</span><button id="reset-trace" type="button" hidden>Clear entries</button></div>
<form id="job-trace-form" autocomplete="off" aria-label="Trace my career">
<label for="workplace-entry">Where do you work? <small>Optional</small></label>
<div class="trace-combobox-wrap"><input id="workplace-entry" type="text" maxlength="160" placeholder="Start typing your workplace" autocomplete="off"/><div id="workplace-suggestions" hidden></div></div><span id="workplace-announcements"></span>
<p id="workplace-affiliation" class="entry-affiliation" hidden></p>
<label for="title-entry">What’s your job title?</label>
<div class="trace-combobox-wrap"><input id="title-entry" type="text" maxlength="120" required placeholder="e.g. ICU registered nurse" autocomplete="off"/><div id="title-suggestions" hidden></div></div><span id="title-announcements"></span>
<p id="title-affiliation" class="entry-affiliation" hidden></p>
<p class="entry-help">Suggestions start after two characters. You can always keep your own wording.</p>
<button class="primary trace-submit" type="submit" disabled>Trace my path <span aria-hidden="true">↗</span></button>
</form><p class="privacy-line">Typing searches downloaded directories in this tab. Shared cards omit your entries.</p>
<details id="more-workplaces" class="more-workplaces"><summary>Search more workplaces</summary><p>Search the U.S. Treasury’s federal award recipient directory. Only clicking the button sends the workplace text to USAspending.</p><button id="search-federal-workplaces" type="button" class="secondary" disabled>Search federal recipients</button><p id="federal-status" role="status"></p><div id="federal-results"></div></details>
<div class="trace-example"><span>Try an example</span><button id="try-trace" type="button" disabled>Nurse at Howard University Hospital ↗</button><button id="try-teacher" data-school={JSON.stringify(teacherSchool)} type="button" disabled>Teacher at Booker T. Washington High, Atlanta ↗</button></div>
<noscript><p>Browse the <a href="#directory">profession index</a> below to follow a field’s history.</p></noscript></div></section>
<section id="match-result" data-timeline-scope aria-label="Career path result" hidden><h2 id="match-heading" tabindex="-1"></h2><p id="match-message"></p><div id="suggested-paths"></div>
<CareerTimeline/>
<SourceLookup/>
<div id="manual-choice" hidden><label for="manual-profession">Choose a profession to explore</label><select id="manual-profession"><option value="">Select a profession…</option>{professions.map(p=><option value={p.slug}>{p.name}</option>)}</select><button type="button" id="manual-open" class="secondary" disabled>Trace this profession →</button></div>
<a href="#trace" class="edit-trace-entry">Edit workplace or title ↑</a>
</section>
<script type="application/json" id="quick-workplaces" set:html={JSON.stringify(quickWorkplaces).replace(/</g,'\\u003c')}></script>
<script>
import {setupTraceEntryFields} from '../lib/trace-entry-fields.js';
import {bindLookup,revealTimelinePreview} from '../lib/bind-lookup.js';
import {matchJobTitle} from '../lib/job-match.js';
import {saveTrace,readTrace,clearTrace} from '../lib/trace-context.js';
const catalog=JSON.parse(document.querySelector('#search-index')!.textContent!);
const form=document.querySelector<HTMLFormElement>('#job-trace-form')!;
const employer=document.querySelector<HTMLInputElement>('#workplace-entry')!;
const job=document.querySelector<HTMLInputElement>('#title-entry')!;
const reset=document.querySelector<HTMLButtonElement>('#reset-trace')!;
const result=document.querySelector<HTMLElement>('#match-result')!;
const heading=document.querySelector<HTMLHeadingElement>('#match-heading')!;
const message=document.querySelector<HTMLElement>('#match-message')!;
const choices=document.querySelector<HTMLElement>('#suggested-paths')!;
const lookup=result.querySelector('pipeline-source-lookup');
const timeline=result.querySelector('pipeline-career-timeline');
const quickWorkplaces=JSON.parse(document.querySelector('#quick-workplaces')!.textContent!);
const entries=setupTraceEntryFields(form,catalog,quickWorkplaces);
function researchHere(profession='',related=false){
 const context={employer:employer.value.trim(),title:job.value.trim(),profession,related,workplaceInfo:entries.workplaceInfo};
 bindLookup(timeline,context);bindLookup(lookup,{...context,profession:related?'':profession});
}
const manual=document.querySelector<HTMLElement>('#manual-choice')!;
const select=document.querySelector<HTMLSelectElement>('#manual-profession')!;
const manualOpen=document.querySelector<HTMLButtonElement>('#manual-open')!;
const savedFields=(restoring=false)=>{
 const saved=readTrace();
 if(restoring||!employer.value)employer.value=saved?.workplace||'';
 if(restoring||!job.value)job.value=saved?.title||'';
 entries.restore(saved?.workplaceInfo);
 reset.hidden=!employer.value&&!job.value;
 if(saved?.match==='unmapped' && saved.title===job.value && saved.workplace===employer.value){showUnmapped();researchHere();manual.hidden=false}
};
function clearResults(){bindLookup(timeline,null);bindLookup(lookup,null);result.hidden=true;manual.hidden=true;select.value='';manualOpen.disabled=true;choices.replaceChildren();job.setCustomValidity('')}
function showResult(title:string,description:string){
 result.hidden=false;heading.textContent=title;message.textContent=description;heading.focus();
}
function openRecord(slug:string,match='title'){
 const record=catalog.find((p:any)=>p.slug===slug);
 if(!record||!job.value.trim())return;
 const url='/p/'+record.slug+'/';
 if(saveTrace({title:job.value,workplace:employer.value,slug:record.slug,match,workplaceInfo:entries.workplaceInfo})){location.assign(url+'#path-preview');return}
 choices.replaceChildren();manual.hidden=true;
 showResult('Your profession is '+record.name,'You can research this workplace here or open the public profession record.');researchHere(record.slug,match==='related');revealTimelinePreview(timeline);
 const link=document.createElement('a');link.className='secondary';link.href=url;link.textContent='Open '+record.name+' →';choices.append(link);
}
function showUnmapped(){
 showResult('Your path from this job',employer.value.trim()?'This title has no national profession card yet. Your timeline keeps the job and workplace you entered and shows where evidence is missing.':'Add a workplace to research this title, or explore a related profession.');
}
form.addEventListener('submit',event=>{
 event.preventDefault();clearResults();const text=job.value.trim();
 if(!text){job.setCustomValidity('Enter your job title.');job.reportValidity();return}
 const matches=matchJobTitle(text,catalog);
 if(matches.length===1){openRecord(matches[0].slug);return}
 if(matches.length){
  for(const match of matches){
   const button=document.createElement('button');button.type='button';button.className='trace-choice';button.textContent=match.name+' →';button.title=match.reason;button.addEventListener('click',()=>openRecord(match.slug));choices.append(button);
  }
  showResult('Which path fits your work?','This job title can belong to more than one profession. Choose the field whose history you want to trace.');
 }else{
  showUnmapped();
  saveTrace({title:job.value,workplace:employer.value,slug:'',match:'unmapped',workplaceInfo:entries.workplaceInfo});
 }
 researchHere();manual.hidden=false;
 if(matches.length===0)revealTimelinePreview(timeline);
});
select.addEventListener('change',()=>manualOpen.disabled=!select.value);
manualOpen.addEventListener('click',()=>openRecord(select.value,'related'));
form.addEventListener('input',()=>{
 clearResults();
 const saved=readTrace();
 if(saved&&(saved.title!==job.value.trim()||saved.workplace!==employer.value.trim()))clearTrace();
 reset.hidden=!job.value&&!employer.value;
});
reset.addEventListener('click',()=>{clearTrace();form.reset();entries.clear();clearResults();reset.hidden=true;employer.focus()});
document.querySelector('#try-trace')!.addEventListener('click',()=>{entries.example('Howard University Hospital');job.value='Registered nurse';reset.hidden=false;form.requestSubmit()});
const teacherExample=document.querySelector<HTMLButtonElement>('#try-teacher')!;
teacherExample.addEventListener('click',()=>{
 const school=JSON.parse(teacherExample.dataset.school!);
 entries.example(school.name,school);job.value='Public school teacher';reset.hidden=false;form.requestSubmit();
});
savedFields();
for(const button of document.querySelectorAll<HTMLButtonElement>('.trace-submit,#try-trace,#try-teacher'))button.disabled=false;
window.addEventListener('pageshow',event=>{if(event.persisted){clearResults();savedFields(true)}});

</script>
