---
import CareerTimeline from './CareerTimeline.astro';
import SourceLookup from './SourceLookup.astro';
import '../styles/personal-trace.css';
import {pathExamples,examplePath,readingPreviewSlugs} from '../lib/path-examples.js';
const {p}=Astro.props;
const demo=pathExamples.find(row=>row.slug===p.slug);
const preview=Astro.url.pathname.startsWith('/preview/p/');
const alternate=readingPreviewSlugs.includes(p.slug) ? (preview ? '/p/' : '/preview/p/') + p.slug + '/' : null;
const publicTrace=demo && {workplace:demo.workplace,title:demo.title,slug:demo.slug,match:'title',workplaceInfo:demo.site &&
  {workplace:demo.workplace,location:demo.site.location,parent:demo.site.parent,relation:demo.site.relation}};
---
<section class="personal-trace" id="personal-trace" data-timeline-scope data-profession={p.slug} data-public-example={publicTrace && JSON.stringify(publicTrace)} aria-label="Your career timeline" hidden>
  <div class="personal-trace__tools">
    <a href={Astro.url.pathname.startsWith('/study/original/') ? '/study/original/#trace' : '/#trace'} data-edit-trace>Edit details</a><button type="button" data-clear-trace>Clear trace</button>
    {demo && !Astro.url.pathname.startsWith('/study/original/') && <button type="button" data-copy-example hidden data-url={new URL(examplePath(p.slug),Astro.site).href}>Copy example link</button>}
    <span data-copy-status role="status" class="example-copy-status"></span>
  </div>
  {alternate && !preview && <div class="personal-edition-switch"><a data-switch-edition data-route={alternate} href={alternate+'#path-preview'}>Try the new reading layout <span aria-hidden="true">→</span></a></div>}
  <CareerTimeline profession={p.slug}/>
  <SourceLookup/>
  <div class="personal-trace__foot">
    {alternate && preview && <a data-switch-edition data-route={alternate} href={alternate+'#path-preview'}>Open the original layout <span aria-hidden="true">→</span></a>}
    <a href="#trend">See Black representation in this profession ↓</a>
    <span data-share-note>Shared links open the public profession card.</span>
    {demo && <a data-example-link hidden href={new URL(examplePath(p.slug).replace('#path-preview','#decisions'),Astro.site).href}>Public link to this example ↗</a>}
  </div>
</section>
<script>
import {bindLookup,revealTimelinePreview} from '../lib/bind-lookup.js';
import {readTrace,clearTrace} from '../lib/trace-context.js';
const panel=document.querySelector<HTMLElement>('#personal-trace');
if(panel){
  const timeline=panel.querySelector('pipeline-career-timeline');
  const lookup=panel.querySelector('pipeline-source-lookup');
  const sample=panel.dataset.publicExample ? JSON.parse(panel.dataset.publicExample) : null;
  const isExample=!!sample && new URL(location.href).searchParams.get('example')==='1';
  const switchLink=panel.querySelector<HTMLAnchorElement>('[data-switch-edition]');
  if(switchLink) switchLink.href=switchLink.dataset.route+(isExample?'?example=1':'')+'#path-preview';
  const copyExample=panel.querySelector<HTMLButtonElement>('[data-copy-example]');
  const copyStatus=panel.querySelector<HTMLElement>('[data-copy-status]')!;
  if(copyExample){
    copyExample.hidden=!isExample;
    copyExample.addEventListener('click',async()=>{
      const url=copyExample.dataset.url!;
      try { await navigator.clipboard.writeText(url); copyStatus.textContent='Link copied.'; }
      catch { const link=document.createElement('a'); link.href=url; link.textContent='Public example link'; copyStatus.replaceChildren(link); }
    });
  }
  const render=()=>{
    const trace=isExample ? sample : readTrace();
    panel.hidden=!trace||trace.slug!==panel.dataset.profession;
    if(!trace||panel.hidden){bindLookup(timeline,null);bindLookup(lookup,null);return}
    panel.querySelector('[data-edit-trace]')!.textContent=isExample?'Trace your own job':'Edit details';
    panel.querySelector<HTMLElement>('[data-clear-trace]')!.hidden=isExample;
    panel.querySelector('[data-share-note]')!.textContent=isExample?'Public example · anyone can open this link.':'Shared links open the public profession card.';
    const sampleLink=panel.querySelector<HTMLElement>('[data-example-link]');
    if(sampleLink)sampleLink.hidden=isExample || trace.workplace!==sample.workplace || trace.title!==sample.title;
    const context={employer:trace.workplace,title:trace.title,profession:trace.slug,related:trace.match==='related',workplaceInfo:trace.workplaceInfo};
    bindLookup(timeline,context);
    bindLookup(lookup,{...context,profession:context.related?'':trace.slug});
  };
  panel.querySelector('[data-clear-trace]')!.addEventListener('click',()=>{
    clearTrace();render();
    const heading=document.querySelector<HTMLElement>('.record-head h1');
    if(heading){heading.tabIndex=-1;heading.focus({preventScroll:true})}
  });
  render();
  if(location.hash==='#path-preview'&&!panel.hidden)revealTimelinePreview(timeline);
  window.addEventListener('pageshow',render);
}
</script>
