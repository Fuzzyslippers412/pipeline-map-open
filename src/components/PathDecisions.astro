---
interface Props {
  profession: string;
  anchor?: boolean;
  workplace?: string;
  subtitle: string;
  label: string;
  records: {date:string; title:string; actor:string; change:string; sources:{title:string; url:string}[]}[];
}
const {profession, anchor, workplace, subtitle, label, records}=Astro.props;
---
<details id={anchor?"decisions":undefined} class="decision-panel" data-decisions-for={profession} data-workplace={workplace} hidden>
  <summary>
    <span class="decision-intro">
      <strong>Decisions behind this path</strong>
      <small>{subtitle}</small>
    </span>
  </summary>
  {profession!=='registered-nurse' && <section class="workplace-connection" aria-labelledby={profession+'-decision-title'}>
    <small data-local-label></small>
    <h3 id={profession+'-decision-title'} data-local-name></h3>
    <p data-local-change hidden></p>
    <a data-local-source hidden target="_blank" rel="noopener noreferrer"></a>
    {profession==='k12-teacher' && <details class="school-source-note" data-school-excerpt hidden>
      <summary>Read the school record</summary>
      <blockquote data-excerpt-text></blockquote>
      <a data-excerpt-link target="_blank" rel="noopener noreferrer"></a>
    </details>}
    {profession==='electrician' && <div data-site-bridge hidden><p></p><a target="_blank" rel="noopener noreferrer"></a></div>}
    <p data-local-gap></p>
  </section>}
  <ol aria-label={label}>
    {records.map(record=><li>
      <span class="decision-date">{record.date}</span>
      <div class="decision-content">
        <h3>{record.title}</h3>
        <p class="decision-actor"><span>Who</span> {record.actor}</p>
        <p class="decision-change"><span class="decision-change-label">What changed</span>{record.change}</p>
        <div class="decision-sources">{record.sources.map(source=>
          <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <span aria-hidden="true">↗</span></a>)}</div>
      </div>
    </li>)}
  </ol>
  <section class="decision-today" data-today hidden>
    <small>Who decides today?</small>
    <h3 data-today-title></h3><p data-today-detail></p><a data-today-link target="_blank" rel="noopener noreferrer"></a>
  </section>
</details>

<style>
  .decision-panel { margin: 11px 0 6px; border-block: 1px solid var(--edge); color: var(--text); }
  .decision-panel > summary { display: flex; align-items: center; gap: 12px; padding: 10px 2px; min-height: 48px; overflow-wrap: anywhere; }
  .decision-panel > summary::before { flex: 0 0 19px; width: 19px; font: 20px/1 var(--mono); text-align: center; }
  .decision-intro strong { display: block; font: 650 16px/1.3 var(--sans); }
  .decision-intro small { display: block; margin-top: 2px; color: var(--muted); font: 12px/1.4 var(--sans); }
  .decision-panel > summary:hover strong { color: var(--lime); }
  .decision-panel ol { max-width: 760px; margin: 0; padding: 0; list-style: none; }
  .decision-panel li { display: grid; grid-template-columns: minmax(4rem, 7rem) minmax(0, 1fr); gap: 12px; padding: 10px 0; border-top: 1px solid var(--edge); }
  .decision-date { padding-top: 2px; color: var(--lime); font: 11px/1.4 var(--mono); }
  .decision-content h3 { margin: 0; color: var(--text); font: 650 16px/1.3 var(--sans); }
  .decision-actor, .decision-change { margin: 4px 0 0; color: var(--muted); font: 13px/1.45 var(--sans); }
  .decision-actor { color: var(--text); }
  .decision-change-label { display: none; }
  .decision-actor > span { margin-right: 3px; color: var(--muted); font: 10px var(--mono); text-transform: uppercase; }
  .decision-sources { display: flex; flex-wrap: wrap; gap: 0 12px; }
  .decision-sources a { display: inline-flex; gap: 3px; align-items: center; min-height: 32px; color: var(--teal); text-decoration: underline; text-underline-offset: 3px; font-size: 12px; }
  .workplace-connection, .decision-today { max-width: 760px; border-top: 1px solid var(--edge); padding: 9px 0; overflow-wrap: anywhere; }
  .workplace-connection small, .decision-today small { color: var(--teal); font: 10px/1.4 var(--mono); text-transform: uppercase; }
  .workplace-connection h3, .decision-today h3 { margin: 3px 0 0; font: 650 15px/1.3 var(--sans); }
  .workplace-connection p, .decision-today p { margin: 4px 0 0; color: var(--muted); font: 13px/1.4 var(--sans); }
  .workplace-connection a, .decision-today a { display: inline-flex; align-items: center; min-height: 32px; text-decoration: underline; color: var(--teal); font-size: 12px; }
  @media(max-width:680px) {
    .decision-panel { margin-top: 4px; }
    .decision-panel > summary { padding-block: 6px; }
    .decision-panel li { grid-template-columns: minmax(0, 1fr); gap: 3px; }
    .decision-sources a { min-height: 36px; }
    [data-decisions-for]:not([data-workplace]) li { padding-block: 8px; gap: 1px; }
    [data-decisions-for]:not([data-workplace]) .decision-sources a { min-height: 32px; }
  }
  :global(body.paper-edition [data-school-edition]) .decision-panel { margin-top: 4px; }
  :global(body.paper-edition [data-school-edition]) .decision-intro small,
  :global(body.paper-edition [data-school-edition]) .workplace-connection small,
  :global(body.paper-edition [data-school-edition]) .decision-today small { font-size: .78rem; }
  :global(body.paper-edition [data-school-edition]) .decision-date { color: var(--rust); font: 500 1.28rem/1.3 var(--serif); }
  :global(body.paper-edition [data-school-edition]) .decision-actor,
  :global(body.paper-edition [data-school-edition]) .decision-change,
  :global(body.paper-edition [data-school-edition]) .workplace-connection p,
  :global(body.paper-edition [data-school-edition]) .decision-today p { font-size: 1rem; line-height: 1.45; }
  :global(body.paper-edition [data-school-edition]) .decision-change-label,
  :global(body.paper-edition [data-school-edition]) .decision-actor > span {
    display: block; margin: 8px 0 2px; color: var(--muted);
    font: 650 .75rem/1.4 var(--sans); letter-spacing: .06em; text-transform: uppercase;
  }
  :global(body.paper-edition [data-school-edition]) .decision-panel a { min-height: 40px; color: var(--action); font-size: .94rem; }
  :global(body.paper-edition [data-school-edition]) .school-source-note {
    margin: 5px 0 12px; padding-left: 15px; border-left: 2px solid var(--rust);
  }
  :global(body.paper-edition [data-school-edition]) .school-source-note summary {
    min-height: 44px; width: fit-content; display: flex; align-items: center;
    color: var(--action); font: 650 .94rem/1.4 var(--sans); text-decoration: underline; text-underline-offset: .18em;
  }
  :global(body.paper-edition [data-school-edition]) .school-source-note blockquote {
    margin: 0 0 4px; max-width: 38ch; font: 500 1.3rem/1.3 var(--serif); color: var(--text);
  }
</style>
