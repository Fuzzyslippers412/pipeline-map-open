---
import {professions} from '../lib/model';
import {historyFor} from '../lib/field-history.js';
import '../styles/field-history.css';
const featured=[['lawyer','bolin-nyc-law-department-1937'],['engineer','mary-jackson-engineer-1958'],['pharmacist','champion-memphis-pharmacy-1981']];
const stories=featured.map(([slug,id])=>{const p=professions.find(p=>p.slug===slug);const record=historyFor(p);return {p,event:record.events.find(event=>event.id===id)}});
---
<section class="home-history" aria-labelledby="history-stories-title">
 <p class="history-kicker">BEHIND THE JOB TITLE</p>
 <div class="home-history-header"><h2 id="history-stories-title">A door opens when someone acts.</h2><a href="#directory">Browse all {professions.length} fields ↓</a></div>
 <nav class="history-updates" aria-label="Recently expanded histories"><span>Also expanded</span><a href="/p/physician/#field-history">Medicine →</a><a href="/p/dentist/#field-history">Dentistry →</a><a href="/p/professor/#field-history">Academia →</a></nav>
 <div class="history-stories">{stories.map(({p,event})=>{return <article class="history-story">
  <span class="history-story-year">{event.year}</span><span class="history-story-field">{p.name}</span>
  <h3><a href={'/p/'+p.slug+'/#field-history'}>{event.title}</a></h3>
  <p>{event.change}</p>
  <a href={'/p/'+p.slug+'/#history-'+event.id}>Read the decision & source →</a>
 </article>})}</div>
</section>
