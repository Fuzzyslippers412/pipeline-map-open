---
import {pmTitles} from '../lib/pm-employer-sources.js';
const {role}=Astro.props;
---
<door-employer-records hidden data-role={role} aria-label={'Employer records for '+pmTitles[role]}>
  <button type="button" data-find>
    <svg width="17" height="17" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg>
    <span>Search employer records</span>
  </button>
  <small data-disclosure></small>
  <p data-status role="status" aria-live="polite" aria-atomic="true"></p>
  <div data-records></div>
  <details data-coverage hidden><summary>Where we looked</summary><p data-checked></p><p data-missing></p></details>
  <a data-wider hidden target="_blank" rel="noopener noreferrer">Search the wider web ↗</a>
</door-employer-records>
<style>
door-employer-records{display:block;margin:10px 0 16px;max-width:66ch;overflow-wrap:anywhere}
button{min-height:44px;padding:9px 14px;display:inline-flex;align-items:center;gap:8px;background:var(--action);color:white;border:1px solid var(--action);border-radius:4px;font:inherit;font-weight:650;cursor:pointer}
button[aria-disabled=true]{opacity:.75;cursor:progress}svg{fill:none;stroke:currentColor;stroke-width:1.8}
small{display:block;color:var(--muted);margin:7px 0;font-size:.81rem}
[data-status]{font-weight:650;margin:10px 0 0}[data-status]:empty{display:none}
details{border-top:1px solid var(--edge);margin-top:8px}summary,a{cursor:pointer;align-content:center;min-height:44px;color:var(--action)}
[data-wider]{display:inline-block;text-underline-offset:.2em}
door-employer-records :global(.pm-source){border-left:3px solid var(--rust);background:var(--panel);padding:12px 14px;margin:.6rem 0}
door-employer-records :global(.pm-source small){display:block;color:var(--muted);font-size:.8rem}
door-employer-records :global(.pm-source a){display:inline-block;color:var(--action);font-weight:650;min-height:44px;align-content:center;text-decoration:underline;text-underline-offset:.18em}
door-employer-records :global(.pm-source p){margin:.45rem 0;line-height:1.5}
door-employer-records :global(.pm-source strong){font-weight:650}
door-employer-records :global(summary){min-height:44px;align-content:center;cursor:pointer;color:var(--action)}
</style>
<script>
import '../lib/pm-employer-element.js';
</script>
