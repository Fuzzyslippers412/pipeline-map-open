<section class="workplace-authority" id="who-decides" aria-labelledby="authority-heading" hidden>
  <header class="authority-head">
    <h3 id="authority-heading" tabindex="-1">Who decides today?</h3>
    <p data-authority-place></p>
  </header>
  <ul class="authority-list" data-authority-entries></ul>
  <template data-authority-template>
    <li>
      <details class="authority-entry">
        <summary>
          <span class="authority-identity"><span class="authority-role" data-authority-role></span><strong data-authority-actor></strong></span>
          <span class="authority-indicator" aria-hidden="true"></span>
        </summary>
        <div class="authority-evidence">
          <p data-authority-decision></p>
          <div class="authority-sources">
            <a data-authority-source target="_blank" rel="noopener noreferrer"></a>
            <a data-authority-local-source target="_blank" rel="noopener noreferrer" hidden></a>
          </div>
        </div>
      </details>
    </li>
  </template>
  <footer class="authority-foot">
    <p data-authority-note></p>
    <span>Sources checked <time data-authority-date></time></span>
  </footer>
</section>
<style>
  .workplace-authority {
    margin: 12px 0 18px;
    padding: 14px 16px 10px;
    border-block: 1px solid var(--edge);
    background: var(--panel);
    scroll-margin-block-start: 18px;
    overflow-wrap: anywhere;
  }
  .authority-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 4px 16px; margin-bottom: 9px; }
  .authority-head h3 { margin: 0; color: var(--text); font: 500 clamp(24px, 3vw, 32px)/1.12 var(--serif); letter-spacing: -.025em; }
  .authority-head p { margin: 0; color: var(--muted); font-size: .88rem; }
  .authority-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 20px; margin: 0; padding: 0; list-style: none; }
  .authority-entry { margin: 0; padding: 0; border-top: 1px solid var(--edge); }
  .authority-entry summary {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 48px; padding: 9px 2px; color: var(--text);
  }
  .authority-entry summary::before { content: none; }
  .authority-identity { display: grid; gap: 2px; }
  .authority-role { color: var(--rust); font: 650 .78rem/1.35 var(--sans); }
  .authority-identity strong { font: 650 1rem/1.3 var(--sans); }
  .authority-indicator { width: 9px; height: 9px; margin-right: 3px; flex: none; border-right: 2px solid var(--action); border-bottom: 2px solid var(--action); transform: translateY(-2px) rotate(45deg); }
  .authority-entry[open] .authority-indicator { transform: translateY(2px) rotate(225deg); }
  .authority-evidence { padding: 0 2px 4px; }
  .authority-evidence p, .authority-foot p { margin: 0; color: var(--muted); line-height: 1.45; }
  .authority-sources { display: flex; flex-wrap: wrap; column-gap: 18px; }
  .authority-evidence a {
    display: inline-flex; align-items: center; min-height: 44px; color: var(--action);
    font-weight: 650; text-decoration: underline; text-underline-offset: .18em;
  }
  .authority-foot { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 4px 14px; padding-top: 8px; border-top: 1px solid var(--edge); }
  .authority-foot p { max-width: 62ch; font-size: .87rem; }
  .authority-foot > span { color: var(--soft); font-size: .77rem; }
  .workplace-authority :is(summary,a,h3):focus-visible { outline: 2px solid var(--action); outline-offset: 2px; }
  @media (max-width: 640px) {
    .workplace-authority { margin-block: 8px 12px; padding: 10px; }
    .authority-list { grid-template-columns: 1fr; }
    .authority-head { display: block; margin-bottom: 6px; }
    .authority-head p { margin-top: 3px; }
    .authority-entry summary { padding-block: 6px; }
  }
</style>
