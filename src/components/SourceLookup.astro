---
import '../styles/source-lookup.css';
---
<pipeline-source-lookup id="workplace-lookup" class="source-lookup" hidden>
  <div class="source-lookup__title">
    <span class="source-lookup__eyebrow">WORKPLACE SOURCE SEARCH</span>
    <h3>Find a workplace connection</h3>
  </div>
  <p class="source-lookup__intro">
    Check current publisher records and previously indexed publications for Black professional pathways at <strong data-employer></strong>.
  </p>
  <dl class="source-lookup__terms">
    <div><dt>Employer sent to sources</dt><dd data-employer-term></dd></div>
    <div><dt>Role used by Door Notes</dt><dd data-title-term></dd></div>
  </dl>
  <p class="source-lookup__help">When you click, Door Notes receives your employer and role to find relevant publications. External publishers receive the employer name only. The search service does not save your entries.</p>
  <button class="primary source-lookup__search" data-search type="button">Look up sources</button>
  <p class="source-lookup__status" data-status role="status" aria-live="polite" aria-atomic="true"></p>
  <div data-results class="source-lookup__results" aria-label="Workplace search results"></div>
  <div class="source-lookup__wider" data-wider hidden>
    <p>For a wider search, open Google with the employer, role and pathway terms below. Google receives those terms only if you open the search.</p>
    <div class="source-lookup__query"><code data-terms></code><button type="button" data-web>Search the wider web ↗</button><button type="button" data-copy>Copy search terms</button></div>
    <span class="source-lookup__copy-status" data-copy-status role="status"></span>
  </div>
</pipeline-source-lookup>

<script>
  type LookupContext = { employer: string; title: string; profession?: string };
  type Result = {
    title: string; url: string; publisher: string; excerpt: string; kind: 'documented' | 'lead';
    mode?: 'live' | 'indexed'; indexedOn?: string; publishedOn?: string; dateBasis?: 'award'|'publication'|'unknown'; dateDetail?: string;
  };
  type Provider = { name: string; status: 'ok' | 'unavailable'; indexedDocuments?: number; indexedOn?: string };
  type Report = {
    status: 'complete' | 'partial' | 'unavailable'; results: Result[]; providers: Provider[];
    index?: {asOf: string; records: number; publishers: number | string[] | Record<string, number>};
  };

  function displayDate(value?: string) {
    if (!value) return '';
    if (/^\d{4}$/.test(value)) return value;
    if (/^\d{4}-\d{2}$/.test(value)) {
      const month=new Date(value+'-01T00:00:00Z');
      return Number.isFinite(month.getTime())?month.toLocaleDateString('en-US',{year:'numeric',month:'short',timeZone:'UTC'}):'';
    }
    if (!/^\d{4}-\d{2}-\d{2}/.test(value)) return '';
    const date = new Date(value.slice(0,10) + 'T00:00:00Z');
    return Number.isFinite(date.getTime()) ? date.toLocaleDateString('en-US', {
      year:'numeric', month:'short', day:'numeric', timeZone:'UTC'
    }) : '';
  }

  function publicLink(raw: string) {
    try {
      const u = new URL(raw);
      return u.protocol === 'https:' && !u.username && !u.password ? u.href : null;
    } catch {
      return null;
    }
  }

  class PipelineSourceLookup extends HTMLElement {
    private context: LookupContext | null = null;
    private pending: AbortController | null = null;

    private part<T extends HTMLElement = HTMLElement>(key: string) {
      return this.querySelector<T>('[data-' + key + ']')!;
    }

    connectedCallback() {
      this.part('search').addEventListener('click', this.search);
      this.part('copy').addEventListener('click', this.copyTerms);
      this.part('web').addEventListener('click', this.widerSearch);
    }

    disconnectedCallback() {
      this.pending?.abort();
      this.pending = null;
      this.part('search').removeEventListener('click', this.search);
      this.part('copy').removeEventListener('click', this.copyTerms);
      this.part('web').removeEventListener('click', this.widerSearch);
    }

    reset() {
      this.pending?.abort();
      this.pending = null;
      this.context = null;
      this.hidden = true;
      this.part('search').removeAttribute('aria-disabled');
      this.part('search').textContent = 'Look up sources';
      this.part('status').textContent = '';
      this.part('results').removeAttribute('aria-busy');
      this.part('results').replaceChildren();
      this.part('wider').hidden = true;
      for (const key of ['employer', 'employer-term', 'title-term', 'terms', 'copy-status']) {
        this.part(key).textContent = '';
      }
    }

    setContext(value: LookupContext | null) {
      const employer = value?.employer?.trim() || '';
      const title = value?.title?.trim() || '';
      const profession = value?.profession?.trim() || '';
      if (!employer || !title) { this.reset(); return; }
      if (this.context?.employer === employer && this.context.title === title && this.context.profession === profession) return;
      this.reset();
      this.context = { employer, title, profession };
      this.part('employer').textContent = employer;
      this.part('employer-term').textContent = employer;
      this.part('title-term').textContent = title;
      this.hidden = false;
    }

    private search = async () => {
      if (!this.context || this.pending) return;
      const controller = new AbortController();
      this.pending = controller;
      const context = this.context;
      const button = this.part<HTMLButtonElement>('search');
      button.setAttribute('aria-disabled', 'true');
      button.textContent = 'Searching…';
      this.part('results').setAttribute('aria-busy', 'true');
      this.part('results').replaceChildren();
      this.part('wider').hidden = true;
      this.part('copy-status').textContent = '';
      this.part('status').textContent = 'Checking public records for ' + context.employer + '…';
      try {
        const { requestResearch } = await import('../lib/request-research.js');
        const report: Report = await requestResearch({ ...context, signal: controller.signal });
        if (controller.signal.aborted || this.pending !== controller) return;
        this.showReport(report);
      } catch {
        if (controller.signal.aborted || this.pending !== controller) return;
        this.part('status').textContent = 'The search could not finish. Try again or copy the search terms below.';
        this.showWiderSearch();
      } finally {
        if (this.pending === controller) {
          this.pending = null;
          button.removeAttribute('aria-disabled');
          button.textContent = 'Search again';
          this.part('results').removeAttribute('aria-busy');
        }
      }
    };

    private showReport(report: Report) {
      this.dispatchEvent(new CustomEvent('pipeline:research-results',{bubbles:true,detail:{context:this.context,report}}));
      const available = report.providers.filter(p => p.status === 'ok').map(p => p.name);
      const missing = report.providers.filter(p => p.status === 'unavailable').map(p => p.name);
      const matches = report.results.filter(r => r.title && publicLink(r.url));
      const documented = matches.filter(r => r.kind === 'documented');
      const leads = matches.filter(r => r.kind === 'lead');
      const status = this.part('status');
      const groups = this.part('results');
      if (!report.providers.length) {
        status.textContent = 'Enter a more specific employer name, such as the full name of your hospital, company or school. No search was run.';
        const edit = document.createElement('a');
        edit.href = document.querySelector('#workplace-entry') ? '#workplace-entry' : '/#trace';
        edit.textContent = 'Edit employer name';
        groups.append(edit);
        return;
      }
      const indexed = matches.filter(r => r.mode === 'indexed').length;
      const live = matches.length - indexed;
      const indexSize = report.index?.records || 0;
      const outcome = [];
      if (matches.length) {
        outcome.push(matches.length + (matches.length === 1 ? ' matching record' : ' matching records') +
          ' (' + live + ' live, ' + indexed + ' indexed).');
      } else if (report.status === 'unavailable') {
        outcome.push(indexSize ? 'No matching publication appeared in the dated index.' : 'No live results are available.');
      } else {
        outcome.push(indexSize ? 'The completed searches and dated index returned no matching record.' : 'The completed searches returned no matching record.');
      }
      if (report.status === 'unavailable') outcome.push('Live publisher searches were unavailable.');
      if (report.status === 'partial') outcome.push('Some live publisher checks were incomplete.');
      if (!matches.length) outcome.push('A connection may still exist.');
      status.textContent = outcome.join(' ');
      if (documented.length) {
        groups.append(this.resultGroup('Documented institutional records', 'These sources name the employer and connect a program or award to this field. Open the original to check its scope and date.', documented));
      }
      if (leads.length) {
        groups.append(this.resultGroup('Leads to investigate', 'These records may help your search. A lead alone does not document a workplace connection.', leads));
      }
      if (report.index?.records) {
        const edition = document.createElement('p');
        edition.className = 'source-lookup__coverage';
        const date = displayDate(report.index.asOf);
        const totals = report.index.publishers;
        const publishers = Array.isArray(totals) ? totals.length : typeof totals === 'number' ? totals : Object.values(totals || {}).filter(count=>count>0).length;
        edition.textContent = 'Index edition' + (date ? ' of ' + date : '') + ' covers ' +
          report.index.records.toLocaleString('en-US') + ' publications' +
          (publishers ? ' from ' + publishers + (publishers === 1 ? ' publisher' : ' publishers') : '') + '.';
        groups.append(edition);
      }
      if (available.length || missing.length) {
        const coverage = document.createElement('p');
        coverage.className = 'source-lookup__coverage';
        const lines = [];
        if (available.length) lines.push('Live sources checked: ' + available.join(', ') + '.');
        if (missing.length) lines.push('Live checks incomplete: ' + missing.join(', ') + '.');
        coverage.textContent = lines.join(' ');
        groups.append(coverage);
      }
      if(this.closest('[data-timeline-scope]')?.querySelector('pipeline-career-timeline:not([hidden])')){
        const link=document.createElement('a');link.href='#path-preview';link.textContent='View updated path preview ↑';groups.append(link);
      }
      if (!documented.length || report.status !== 'complete') this.showWiderSearch();
    }

    private resultGroup(label: string, note: string, records: Result[]) {
      const section = document.createElement('section');
      const heading = document.createElement('h4');
      heading.textContent = label;
      const description = document.createElement('p');
      description.className = 'source-lookup__help';
      description.textContent = note;
      const list = document.createElement('ul');
      for (const record of records) {
        const item = document.createElement('li');
        const publisher = document.createElement('span');
        publisher.className = 'source-lookup__publisher';
        publisher.textContent = record.publisher;
        const timing = document.createElement('span');
        timing.className = 'source-lookup__timing';
        const indexed = record.mode === 'indexed';
        timing.dataset.mode = indexed ? 'indexed' : 'live';
        const date = displayDate(record.indexedOn);
        timing.textContent = indexed ? 'Indexed publication' + (date ? ' · ' + date : '') : 'Retrieved live';
        const published = displayDate(record.publishedOn);
        if (published) timing.textContent += ' · '+(record.dateDetail||(record.dateBasis==='award'?'Award date':'Published'))+' '+published;
        const link = document.createElement('a');
        link.href = publicLink(record.url)!;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = record.title + ' ↗';
        item.append(publisher, timing, link);
        if (record.excerpt) {
          const excerpt = document.createElement('p');
          excerpt.className = 'source-lookup__excerpt';
          excerpt.textContent = record.excerpt;
          item.append(excerpt);
        }
        list.append(item);
      }
      section.append(heading, description, list);
      return section;
    }

    private showWiderSearch() {
      if (!this.context) return;
      const { employer, title } = this.context;
      this.part('terms').textContent = '"' + employer + '" ' + title + ' (HBCU OR "Black professionals") training';
      this.part('wider').hidden = false;
    }

    private widerSearch = () => {
      const terms = this.part('terms').textContent;
      if (!this.context || !terms) return;
      const destination = new URL('https://www.google.com/search');
      destination.searchParams.set('q', terms);
      window.open(destination.href, '_blank', 'noopener,noreferrer');
    };

    private copyTerms = async () => {
      const terms = this.part('terms').textContent || '';
      const context = this.context;
      let status = 'Search terms copied.';
      try {
        if (!navigator.clipboard || !terms) throw Error();
        await navigator.clipboard.writeText(terms);
      } catch {
        status = 'Select and copy the search terms shown above.';
      }
      if (this.context === context) this.part('copy-status').textContent = status;
    };
  }

  if (!customElements.get('pipeline-source-lookup')) {
    customElements.define('pipeline-source-lookup', PipelineSourceLookup);
  }
</script>
